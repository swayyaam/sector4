---
import "../../styles/global.css";
import Seo from "../seo/Seo.astro";
import PreviewBanner from "./PreviewBanner.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { loadDataset } from "../../lib/data";

interface Props {
  title: string;
  description: string;
  /** Site-relative path to this page's Open Graph card. */
  image?: string | undefined;
  imageAlt?: string | undefined;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
}
const { title, description, image, imageAlt, jsonLd = [], breadcrumbs = [] } = Astro.props;
const path = Astro.url.pathname;
const { meta, isMock } = loadDataset();
const site = Astro.site!.href.replace(/\/$/, "");

const crumbs =
  breadcrumbs.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: breadcrumbs.map((b, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: b.name,
            item: `${site}${b.path}`,
          })),
        },
      ]
    : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/inter-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <Seo
      title={title}
      description={description}
      path={path}
      image={image}
      imageAlt={imageAlt}
      jsonLd={[...jsonLd, ...crumbs]}
    />
  </head>
  <body>
    <a href="#main" class="skip btn btn-primary">
      Skip to content
    </a>
    {isMock && <PreviewBanner />}
    <SiteHeader path={path} next={meta.next_race} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter
      dataVersion={meta.data_version}
      generatedAt={meta.generated_at}
      lastCompleted={meta.last_completed_race}
    />

    <script>
      /*
       * Every instant is rendered at build time in UTC, which is correct but
       * not where the reader is. This rewrites each one into the reader's own
       * zone and keeps the UTC original as the hover title. Without script the
       * page still reads correctly, in UTC.
       */
      const FORMATS: Record<string, Intl.DateTimeFormatOptions> = {
        datetime: {
          weekday: "short",
          day: "numeric",
          month: "short",
          hour: "2-digit",
          minute: "2-digit",
        },
        time: { hour: "2-digit", minute: "2-digit" },
        day: { weekday: "long", day: "numeric", month: "long" },
      };
      for (const el of document.querySelectorAll<HTMLTimeElement>("time[data-local]")) {
        const at = new Date(el.dateTime);
        if (Number.isNaN(at.getTime())) continue;
        el.title = el.textContent?.trim() ?? "";
        el.textContent = at.toLocaleString(undefined, FORMATS[el.dataset.local || "datetime"]);
      }
      const zone = Intl.DateTimeFormat().resolvedOptions().timeZone.replace(/_/g, " ");
      const hover = matchMedia("(hover: hover)").matches ? " Hover a time for UTC." : "";
      for (const el of document.querySelectorAll<HTMLElement>("[data-zone]")) {
        el.textContent = `Times in your zone, ${zone}.${hover}`;
      }
    </script>
    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: var(--space-sm);
        z-index: 10;
      }
      .skip:focus {
        left: var(--space-sm);
      }
    </style>
  </body>
</html>
