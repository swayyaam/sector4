---
import "../../styles/global.css";
import Seo from "../seo/Seo.astro";
import PreviewBanner from "./PreviewBanner.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { loadDataset } from "../../lib/data";

interface Props {
  title: string;
  description: string;
  /** Site-relative path to this page's Open Graph card. */
  image?: string | undefined;
  imageAlt?: string | undefined;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
}
const { title, description, image, imageAlt, jsonLd = [], breadcrumbs = [] } = Astro.props;
const path = Astro.url.pathname;
const { meta, isMock } = loadDataset();
const site = (Astro.site ?? new URL("https://sector4.dev")).href.replace(/\/$/, "");

const crumbs =
  breadcrumbs.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: breadcrumbs.map((b, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: b.name,
            item: `${site}${b.path}`,
          })),
        },
      ]
    : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/inter-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <Seo
      title={title}
      description={description}
      path={path}
      image={image}
      imageAlt={imageAlt}
      jsonLd={[...jsonLd, ...crumbs]}
    />
  </head>
  <body>
    <a href="#main" class="skip">
      Skip to content
    </a>
    {isMock && <PreviewBanner />}
    <SiteHeader path={path} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter dataVersion={meta.data_version} generatedAt={meta.generated_at} />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--colour-action);
        color: var(--colour-on-action);
        padding: var(--space-sm) var(--space-base);
        border-radius: 0 0 var(--radius-sm) 0;
        font-weight: 600;
        z-index: 10;
      }
      .skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
