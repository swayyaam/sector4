---
/**
 * Full-field probability table.
 *
 * ex-data-table-cell chrome from DESIGN.md. Numbers use tabular figures and
 * are right-aligned; names carry a team marker plus the team's short name so
 * the colour is never doing the work alone. Rows arrive in order and their
 * bars fill after them.
 */
import ProbabilityBar from "./ProbabilityBar.astro";
import TeamMarker from "./TeamMarker.astro";
import { driverName, percent, position } from "../../lib/format";
import type { Driver, DriverPrediction, Team } from "../../lib/schema";

interface Props {
  rows: DriverPrediction[];
  drivers: Map<number, Driver>;
  teams: Map<string, Team>;
  caption: string;
}
const { rows, drivers, teams, caption } = Astro.props;
const maxWin = Math.max(...rows.map((r) => r.p_win));
---

<table class="table probs">
  <caption class="sr-only">{caption}</caption>
  <thead>
    <tr>
      <th scope="col" class="pos">
        #
      </th>
      <th scope="col">Driver</th>
      <th scope="col" class="n">
        Win
      </th>
      <th scope="col" class="barcol">
        <span class="sr-only">Win, relative to the favourite</span>
      </th>
      <th scope="col" class="n">
        Podium
      </th>
      <th scope="col" class="n">
        Top 10
      </th>
      <th scope="col" class="n">
        DNF
      </th>
      <th scope="col" class="n">
        Expected
      </th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r, i) => {
      const d = drivers.get(r.driverId);
      const t = teams.get(r.team_entity_id);
      return (
        <tr class="rise" style={`--i:${i}`}>
          <td class="pos num dim">{i + 1}</td>
          <th scope="row">
            <span class="who">
              {t && <TeamMarker colour={t.colour_on_light} name={t.name} />}
              <span>
                <span class="name">{d ? driverName(d) : `Driver ${r.driverId}`}</span>
                <span class="team">{t?.short_name ?? "Unknown team"}</span>
              </span>
            </span>
          </th>
          <td class="n num win" data-label="Win">
            {percent(r.p_win)}
          </td>
          <td class="barcol">
            <ProbabilityBar value={r.p_win} columnMax={maxWin} index={i} />
          </td>
          <td class="n num" data-label="Podium">
            {percent(r.p_podium)}
          </td>
          <td class="n num" data-label="Top 10">
            {percent(r.p_top10)}
          </td>
          <td class="n num dim" data-label="DNF">
            {percent(r.p_dnf)}
          </td>
          <td class="n num dim" data-label="Expected">
            {position(r.expected_position)}
          </td>
        </tr>
      );
    })}
  </tbody>
</table>

<style>
  .probs {
    min-width: 0;
  }
  .pos {
    width: 3rem;
  }
  .barcol {
    width: 22%;
    min-width: 120px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .name {
    display: block;
    color: var(--colour-ink);
    font-size: 16px;
    line-height: 1.38;
    font-weight: var(--weight-strong);
  }
  .team {
    display: block;
    font-size: 12px;
    line-height: 1.33;
    font-weight: var(--weight-text);
    color: var(--colour-text-muted);
  }
  .win {
    color: var(--colour-ink);
    font-weight: var(--weight-strong);
  }

  /* Below 640px each row becomes a two-line block rather than scrolling. */
  @media (max-width: 639px) {
    thead,
    .barcol,
    .pos {
      display: none;
    }
    tbody tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xxs) var(--space-sm);
      padding: var(--space-sm) var(--space-xs);
    }
    tbody th {
      grid-column: 1 / -1;
      padding: 0 0 var(--space-xs);
    }
    tbody td {
      padding: 0;
      text-align: left;
      font-size: 14px;
      white-space: nowrap;
    }
    /* Decorative: the <th> in thead still names the column for assistive tech. */
    tbody td::before {
      content: attr(data-label) " ";
      color: var(--colour-text-muted);
    }
  }
</style>
