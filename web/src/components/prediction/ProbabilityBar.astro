---
/**
 * Inline magnitude bar.
 *
 * Fill is ink, not the action colour and not the team colour: purple would
 * read as interactive, and team colour would make magnitude look like
 * identity. Width is relative to the column maximum so small differences stay
 * visible. Decorative — the number beside it is the accessible value.
 */
import { barWidth } from "../../lib/format";
interface Props {
  value: number;
  columnMax: number;
}
const { value, columnMax } = Astro.props;
const w = barWidth(value, columnMax);
---

<span class="track" aria-hidden="true"><span class="fill" style={`width:${w}%`}></span></span>

<style>
  .track {
    display: block;
    width: 100%;
    height: 6px;
    border-radius: var(--radius-xs);
    background: var(--colour-surface-strong);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    border-radius: var(--radius-xs);
    background: var(--colour-ink);
  }
</style>
