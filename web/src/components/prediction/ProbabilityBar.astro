---
/**
 * Inline magnitude bar: ink on a field track, pill-ended.
 *
 * Ink rather than team colour, because team colour would make magnitude look
 * like identity. Width is relative to the column maximum so small differences
 * stay visible. It fills from the left after its row arrives (global .bar), by
 * transform, never by width. Decorative — the number beside it is the value.
 */
import { barWidth } from "../../lib/format";
interface Props {
  value: number;
  columnMax: number;
  /** Position in its list, for the stagger. */
  index?: number;
}
const { value, columnMax, index = 0 } = Astro.props;
const w = barWidth(value, columnMax);
---

<span class="bar" aria-hidden="true">
  <span style={`--w:${w.toFixed(2)}%;--i:${index}`}></span>
</span>
