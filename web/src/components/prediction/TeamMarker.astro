---
/**
 * Team identity mark. Colour is data, never chrome: a small squircle at the
 * 30% radius of DESIGN.md's app-icon tile, always beside the team's name in
 * text so colour is never the only channel.
 */
interface Props {
  colour: string;
  name: string;
}
const { colour, name } = Astro.props;
---

<span class="marker" style={`background:${colour}`} aria-hidden="true" data-team={name}></span>

<style>
  .marker {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 30%;
    flex: none;
  }
</style>
