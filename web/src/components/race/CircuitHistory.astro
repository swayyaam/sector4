---
/**
 * What happened at this circuit before this race.
 *
 * From reference.circuit_history, built by src/build_site_data.py over the same
 * window as the model's circuit features. A circuit with no history says so;
 * it never shows a stand-in figure.
 */
import type { Circuit, CircuitHistory } from "../../lib/schema";
import { percent } from "../../lib/format";
interface Props {
  history: CircuitHistory | undefined;
  circuit: Circuit;
  season: number;
}
const { history: h, circuit, season } = Astro.props;
const span =
  h && h.first_season !== null && h.last_season !== null
    ? h.first_season === h.last_season
      ? `${h.first_season}`
      : `${h.first_season}–${h.last_season}`
    : null;
---

{!h || h.prior_races === 0 ? (
  <p class="notice">
    <span class="badge badge-ink">New</span>
    <span>
      No race has been run at {circuit.name} before this one, so there is no history to show.
    </span>
  </p>
) : (
  <div class="history">
    <dl class="figures">
      <div class="rise" style="--i:0">
        <dt>Average places moved</dt>
        <dd class="num">{h.mean_position_change!.toFixed(1)} places</dd>
      </div>
      <div class="rise" style="--i:1">
        <dt>Cars that retired</dt>
        <dd class="num">{percent(h.retirement_rate!, 0)}</dd>
      </div>
      <div class="rise" style="--i:2">
        <dt>Won from the front of the grid</dt>
        <dd class="num">
          {h.grid_one_wins} of {h.grid_one_races}
        </dd>
      </div>
    </dl>
    <p class="body-sm muted scope">
      From the {h.prior_races} {h.prior_races === 1 ? "race" : "races"} at {circuit.name} before
      this one, {span}.
      {h.last_season !== null && h.last_season < 2026 && season >= 2026 && (
        <> All of them were run before the 2026 regulations.</>
      )}
    </p>
    <details class="defs disclosure body-sm">
      <summary>How these are counted</summary>
      <ul>
        <li>
          <strong>Average places moved</strong> is how many places each car gained or lost between
          the start and the finish, on average, counting every car that started from a grid slot.
          Low means the starting order mostly holds.
        </li>
        <li>
          <strong>Cars that retired</strong> is the share of entries that did not finish.
        </li>
        <li>
          <strong>Won from the front of the grid</strong> counts the car that started first, not the
          fastest qualifier: a penalty can move the pole-sitter back, and the results record where
          each car started.
        </li>
      </ul>
    </details>
  </div>
)}

<style>
  .history {
    display: grid;
    gap: var(--space-md);
  }
  .scope {
    max-width: 68ch;
  }
  .defs ul {
    margin: 0;
    padding-left: var(--space-lg);
    display: grid;
    gap: var(--space-xs);
    max-width: 68ch;
    color: var(--colour-text-muted);
  }
  .defs strong {
    color: var(--colour-ink);
  }
</style>
