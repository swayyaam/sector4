---
/**
 * Circuit outline, inlined as SVG so it inherits token colours and costs no
 * extra request. Geometry from the MIT-licensed f1-circuits dataset; credited
 * here and on /credits/.
 */
import type { Circuit } from "../../lib/schema";
interface Props {
  circuit: Circuit;
}
const { circuit } = Astro.props;
---

<figure class="card-soft outline">
  {circuit.track_path ? (
    <svg
      viewBox={circuit.track_view_box ?? "0 0 1000 1000"}
      class="map"
      role="img"
      aria-label={`Outline of ${circuit.name}`}
    >
      <path d={circuit.track_path} />
    </svg>
  ) : (
    <div class="none" role="img" aria-label="No circuit outline available">
      <span>No outline</span>
    </div>
  )}
  <figcaption>
    <p class="title">{circuit.name}</p>
    <p class="muted body-sm">
      {circuit.locality}, {circuit.country}
    </p>
    <p class="credit caption">
      Outline: <a href="https://github.com/bacinger/f1-circuits">f1-circuits</a> by Tomislav
      Bacinger, MIT
    </p>
  </figcaption>
</figure>

<style>
  .outline {
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }
  .map {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    max-height: 280px;
  }
  .map path {
    fill: none;
    stroke: var(--colour-ink);
    stroke-width: 14;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .none {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-height: 280px;
    background: var(--colour-field);
    border-radius: var(--rounded-sm);
    color: var(--colour-text-muted);
    font-size: 14px;
  }
  .credit {
    margin-top: var(--space-xs);
    color: var(--colour-text-muted);
  }
</style>
