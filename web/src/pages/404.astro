---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { loadDataset, raceById, scoredPredictions } from "../lib/data";

const { reference, predictions, meta } = loadDataset();
const races = raceById(reference);
const next = meta.next_race;
const last = scoredPredictions(predictions)[0];
const lastRace = last ? races.get(last.race_id) : undefined;
---

<BaseLayout title="Page not found" description="That page does not exist on Sector 4.">
  <section class="wrap page-hero centred">
    <p class="display num" aria-hidden="true">
      404
    </p>
    <h1 class="h2">That page does not exist.</h1>
    <p class="lead">
      Race pages live at <span class="num">/races/&lt;season&gt;/&lt;race-slug&gt;/</span>, and only
      for races a prediction was published for. If you followed a link from elsewhere on this site,
      that is a bug worth reporting.
    </p>
  </section>

  <section class="wrap band">
    <ul class="links">
      {next && (
        <li class="rise" style="--i:0">
          <a class="card" href={`/races/${next.season}/${next.slug}/`}>
            <span class="title">{next.name}</span>
            <span class="body-sm muted">The next race</span>
          </a>
        </li>
      )}
      {lastRace && (
        <li class="rise" style="--i:1">
          <a class="card" href={`/races/${lastRace.season}/${lastRace.slug}/`}>
            <span class="title">{lastRace.name}</span>
            <span class="body-sm muted">The most recent scored race</span>
          </a>
        </li>
      )}
      <li class="rise" style="--i:2">
        <a class="card" href="/track-record/">
          <span class="title">Track record</span>
          <span class="body-sm muted">Every prediction, scored</span>
        </a>
      </li>
      <li class="rise" style="--i:3">
        <a class="card" href="/methodology/">
          <span class="title">Methodology</span>
          <span class="body-sm muted">How the numbers are made</span>
        </a>
      </li>
      <li class="rise" style="--i:4">
        <a class="card" href="/">
          <span class="title">Home</span>
          <span class="body-sm muted">Start again</span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .centred {
    justify-items: center;
    text-align: center;
  }
  .links {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    max-width: 960px;
  }
  @media (min-width: 720px) {
    .links {
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    }
  }
  .links .card {
    display: grid;
    gap: var(--space-xxs);
    height: 100%;
  }
</style>
