---
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import PositionDistribution from "../../../components/prediction/PositionDistribution.astro";
import ProbabilityTable from "../../../components/prediction/ProbabilityTable.astro";
import Provenance from "../../../components/prediction/Provenance.astro";
import TeamMarker from "../../../components/prediction/TeamMarker.astro";
import CircuitCard from "../../../components/race/CircuitCard.astro";
import CircuitHistory from "../../../components/race/CircuitHistory.astro";
import Countdown from "../../../components/race/Countdown.astro";
import SessionTimes from "../../../components/race/SessionTimes.astro";
import {
  circuitById,
  circuitHistoryFor,
  driverById,
  driversByWinProbability,
  loadDataset,
  predictionsForRace,
  raceById,
  teamById,
} from "../../../lib/data";
import { driverName, logLoss, percent, position, score, sentenceStart } from "../../../lib/format";
import type { Prediction } from "../../../lib/schema";
import { BASELINE_FOR, SNAPSHOT_BLURB, SNAPSHOT_LABEL } from "../../../lib/snapshots";
import { formatUtc, isPast } from "../../../lib/time";

export async function getStaticPaths() {
  const { reference, predictions } = loadDataset();
  const withPredictions = new Set(predictions.map((p) => p.race_id));
  return reference.races
    .filter((r) => withPredictions.has(r.race_id))
    .map((r) => ({
      params: { season: String(r.season), slug: r.slug },
      props: { raceId: r.race_id },
    }));
}

const { raceId } = Astro.props;
const { reference, predictions, meta } = loadDataset();
const drivers = driverById(reference);
const teams = teamById(reference);
const circuits = circuitById(reference);
const race = raceById(reference).get(raceId)!;
const circuit = circuits.get(race.circuit_id)!;
const history = circuitHistoryFor(reference, raceId);

// Post-qualifying first when it exists: it is the sharper of the two, and the
// one a reader arriving on race day wants.
const snapshots = predictionsForRace(predictions, raceId);
const shown = snapshots[0]!;
const scoredWith = snapshots.find((s) => s.result !== null) ?? null;
const result = scoredWith?.result ?? null;
const now = new Date();
const started = isPast(race.starts_at, now);
const sessions =
  race.sessions.length > 0
    ? race.sessions
    : meta.next_race?.race_id === raceId
      ? meta.next_race.sessions
      : [];

const actualById = new Map((result?.drivers ?? []).map((d) => [d.driverId, d]));

/** "A", "A and B", "A, B and C", from driver ids. */
function nameList(ids: number[]): string {
  const names = ids.map((id) => {
    const d = drivers.get(id);
    return d ? driverName(d) : `Driver ${id}`;
  });
  if (names.length <= 1) return names[0] ?? "";
  return `${names.slice(0, -1).join(", ")} and ${names[names.length - 1]}`;
}

/**
 * Why a snapshot has no log loss on this race, as a sentence, or "" when it
 * has one. Built here as one string so no line break can put a space before
 * the punctuation.
 */
function noLogLoss(r: NonNullable<Prediction["result"]>): string {
  if (r.log_loss_undefined === null) return "";
  const winner = r.drivers.find((d) => d.actual_position === 1)?.driverId;
  const who = winner === undefined ? "The winner" : nameList([winner]);
  const how =
    r.log_loss_undefined === "winner_not_in_field"
      ? `${who} won without being in this snapshot's field`
      : `${who} won with a win probability published as 0.0 to six decimal places`;
  return (
    `${how}, so the snapshot gave the winner no probability and has no log loss. It is left ` +
    "empty rather than filled with an arbitrary number. The winner counts as missed, the Brier " +
    "score charges the full miss, and the track record's mean log loss leaves this race out " +
    "and says so."
  );
}
const finalOrder = scoredWith
  ? [...scoredWith.drivers].sort((a, b) => {
      const pa = actualById.get(a.driverId)?.actual_position ?? 99;
      const pb = actualById.get(b.driverId)?.actual_position ?? 99;
      return pa - pb || b.p_win - a.p_win;
    })
  : [];

const title = `${race.season} ${race.name} — win and podium probabilities`;
const description = result
  ? `How Sector 4's ${race.season} ${race.name} prediction turned out: log loss ${logLoss(result.log_loss).toLowerCase()}, ` +
    `${result.podium_hits} of 3 podium places, winner ${result.winner_hit ? "called" : "missed"}.`
  : `Win, podium, top-ten and DNF probabilities for all ${shown.drivers.length} drivers at the ` +
    `${race.season} ${race.name}, with the factors behind each.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SportsEvent",
    name: `${race.season} ${race.name}`,
    startDate: race.starts_at,
    eventStatus: "https://schema.org/EventScheduled",
    location: {
      "@type": "Place",
      name: circuit.name,
      address: {
        "@type": "PostalAddress",
        addressLocality: circuit.locality,
        addressCountry: circuit.country,
      },
      geo: { "@type": "GeoCoordinates", latitude: circuit.lat, longitude: circuit.lng },
    },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/races/${race.season}/${race.slug}.png`}
  imageAlt={`${race.season} ${race.name}: the three drivers most likely to win, with probabilities.`}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: "Track record", path: "/track-record/" },
    { name: `${race.season} ${race.name}`, path: `/races/${race.season}/${race.slug}/` },
  ]}
>
  <section class="wrap head">
    <div class="title-block">
      <p class="kicker">
        {!started && <span class="badge badge-accent">Upcoming</span>}
        <span class="muted body-sm">
          Round {race.round} of {race.season}
        </span>
      </p>
      <h1>{race.name}</h1>
      <p class="lead">
        {circuit.name}, {circuit.locality}, {circuit.country}
      </p>
    </div>

    <div class="card-soft when">
      {started ? (
        <>
          <p class="h3">Race complete</p>
          <p class="muted body-sm">
            Started{" "}
            <time datetime={race.starts_at} data-local>
              {formatUtc(race.starts_at)}
            </time>
          </p>
        </>
      ) : (
        <>
          <p class="body-sm muted">Race starts in</p>
          <Countdown startsAt={race.starts_at} />
          {sessions.length > 0 ? (
            <SessionTimes sessions={sessions} />
          ) : (
            <p class="body-sm">
              Race{" "}
              <time datetime={race.starts_at} data-local>
                {formatUtc(race.starts_at)}
              </time>
            </p>
          )}
        </>
      )}
    </div>
  </section>

  {result && scoredWith && (
    <section class="wrap band" aria-labelledby="result-h">
      <div class="section-head">
        <p class="eyebrow">Result</p>
        <h2 id="result-h">Predicted against actual.</h2>
        <p>
          Scored on the {SNAPSHOT_LABEL[scoredWith.snapshot].toLowerCase()} snapshot, the one
          published before the session it predicts. Nothing here is recalculated after the fact.
        </p>
      </div>
      <dl class="figures scores">
        <div class="rise" style="--i:0">
          <dt>Log loss</dt>
          <dd class="num">{logLoss(result.log_loss)}</dd>
        </div>
        {result.baseline && (
          <div class="rise" style="--i:1">
            <dt>{sentenceStart(result.baseline.name)}, same race</dt>
            <dd class="num">{score(result.baseline.log_loss)}</dd>
          </div>
        )}
        <div class="rise" style="--i:2">
          <dt>Brier</dt>
          <dd class="num">{score(result.brier)}</dd>
        </div>
        <div class="rise" style="--i:3">
          <dt>Winner</dt>
          <dd>{result.winner_hit ? "Called" : "Missed"}</dd>
        </div>
        <div class="rise" style="--i:4">
          <dt>Podium places</dt>
          <dd class="num">{result.podium_hits} of 3</dd>
        </div>
      </dl>
      {result.log_loss_undefined && (
        <p class="notice">
          <span class="badge badge-ink">No log loss</span>
          <span>{noLogLoss(result)}</span>
        </p>
      )}

      <div class="scroller">
        <table class="table wide">
          <caption class="sr-only">
            Every driver's finishing position beside the probability given before the race.
          </caption>
          <thead>
            <tr>
              <th scope="col">Pos</th>
              <th scope="col">Driver</th>
              <th scope="col" class="n">
                Win
              </th>
              <th scope="col" class="n">
                Podium
              </th>
              <th scope="col" class="n">
                Expected
              </th>
              <th scope="col" class="n">
                Beat expected by
              </th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {finalOrder.map((row, i) => {
              const d = drivers.get(row.driverId);
              const t = teams.get(row.team_entity_id);
              const a = actualById.get(row.driverId);
              const pos = a?.actual_position ?? null;
              const delta = pos === null ? null : row.expected_position - pos;
              return (
                <tr class="rise" style={`--i:${i}`}>
                  <td class="num dim">{pos === null ? "—" : pos}</td>
                  <th scope="row">
                    <span class="who">
                      {t && <TeamMarker colour={t.colour_on_light} name={t.name} />}
                      <span>
                        {d ? driverName(d) : `Driver ${row.driverId}`}
                        <span class="team">{t?.short_name ?? "Unknown team"}</span>
                      </span>
                    </span>
                  </th>
                  <td class="n num">{percent(row.p_win)}</td>
                  <td class="n num">{percent(row.p_podium)}</td>
                  <td class="n num dim">{position(row.expected_position)}</td>
                  <td class="n num">
                    {delta === null
                      ? "—"
                      : `${delta > 0 ? "+" : delta < 0 ? "−" : ""}${position(Math.abs(delta))}`}
                  </td>
                  <td class="dim">{a?.status ?? "Unknown"}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="note">
        Beat expected by is expected position minus actual: positive means the driver finished ahead
        of the prediction. A driver who did not finish has no position, so no figure.
      </p>
    </section>
  )}

  <section class="wrap band" aria-labelledby="field-h">
    <div class="section-head">
      <p class="eyebrow">Prediction</p>
      <h2 id="field-h">Full field</h2>
      <p>
        Every driver's chance of winning, reaching the podium and finishing in the top ten. Only the
        win probability has been validated. Podium, top ten and finishing order follow from it
        through one simulation of the whole race; the DNF figure is a separate fit that has not been
        validated.
      </p>
    </div>

    {snapshots.length > 1 && (
      <fieldset class="seg">
        <legend class="sr-only">Snapshot</legend>
        {snapshots.map((s, i) => (
          <>
            <input
              type="radio"
              name="snapshot"
              id={`snap-${s.snapshot}`}
              value={s.snapshot}
              checked={i === 0}
            />
            <label for={`snap-${s.snapshot}`}>{SNAPSHOT_LABEL[s.snapshot]}</label>
          </>
        ))}
      </fieldset>
    )}

    <div class="panels">
      {snapshots.map((s) => {
        const rows = driversByWinProbability(s);
        return (
          <div class="panel" data-snap={s.snapshot}>
            <p class="meta body-sm">
              <span class="badge badge-soft">{SNAPSHOT_LABEL[s.snapshot]}</span>
              <span>
                {SNAPSHOT_BLURB[s.snapshot]} Scored beside {BASELINE_FOR[s.snapshot]}.
              </span>
            </p>
            <Provenance
              generatedAt={s.generated_at}
              revision={s.revision}
              commit={s.published_commit}
              model={s.model_version}
              data={s.data_version}
            />
            {s.snapshot === "pre_weekend" && (
              <p class="notice">
                <span class="badge badge-ink">Two features</span>
                <span>
                  Qualifying position and practice pace do not exist yet, so this snapshot falls
                  back to championship points and share of team points. It is a weaker model than
                  the post-qualifying one, not a different view of the same thing. The{" "}
                  <a href="/methodology/">methodology page</a> says what the full model uses.
                </span>
              </p>
            )}
            {s.result &&
              (s.result.unpredicted_starters.length > 0 ||
                s.result.predicted_non_starters.length > 0) && (
                <p class="notice">
                  <span class="badge badge-ink">Field change</span>
                  <span>
                    {s.result.unpredicted_starters.length > 0 &&
                      `${nameList(s.result.unpredicted_starters)} started the race without being in this snapshot's field${s.snapshot === "pre_weekend" ? ", which was carried over from the previous race's starters" : ""}. `}
                    {s.result.predicted_non_starters.length > 0 &&
                      `${nameList(s.result.predicted_non_starters)} ${s.result.predicted_non_starters.length === 1 ? "was" : "were"} in the field and did not start, so ${s.result.predicted_non_starters.length === 1 ? "was" : "were"} left out when this snapshot was scored, and the other probabilities were renormalised.`}
                  </span>
                </p>
              )}
            {s.result?.log_loss_undefined && s !== scoredWith && (
              <p class="notice">
                <span class="badge badge-ink">No log loss</span>
                <span>{noLogLoss(s.result)}</span>
              </p>
            )}
            {s.revisions.length > 1 && (
              <details class="revisions disclosure">
                <summary>
                  Revision history: {s.revisions.length} published, revision {s.revision} counts
                </summary>
                <ol>
                  {s.revisions.map((r) => (
                    <li>
                      <p>
                        <strong>Revision {r.revision}.</strong>{" "}
                        {r.effective
                          ? "The one that counts."
                          : r.late
                            ? "Published after the session started, so not scored."
                            : "Superseded."}
                      </p>
                      <Provenance
                        generatedAt={r.generated_at}
                        revision={r.revision}
                        commit={r.published_commit}
                      />
                      {r.reason && <p class="reason">{r.reason}</p>}
                    </li>
                  ))}
                </ol>
              </details>
            )}

            <div class="scroller">
              <ProbabilityTable
                rows={rows}
                drivers={drivers}
                teams={teams}
                caption={`${SNAPSHOT_LABEL[s.snapshot]} probabilities for all ${rows.length} drivers, most likely winner first.`}
              />
            </div>

            <div class="sub">
              <h3>Finishing order</h3>
              <p class="muted body-sm">
                Where the simulation places each driver, one column per position, all on one scale.
                It does not model retirements: every car is placed somewhere in the order, and the
                chance of retiring is the separate DNF column above.
              </p>
            </div>
            <PositionDistribution rows={rows} drivers={drivers} teams={teams} />

            <div class="sub">
              <h3>What is driving each number</h3>
              <p class="muted body-sm">
                Each factor's share of the driver's score, not a lap time or any timing value.
              </p>
            </div>
            <ul class="factors">
              {rows.map((r, i) => {
                const d = drivers.get(r.driverId);
                const t = teams.get(r.team_entity_id);
                return (
                  <li>
                    <details class="disclosure" open={i < 3}>
                      <summary>
                        <span class="fname">{d ? driverName(d) : `Driver ${r.driverId}`}</span>
                        <span class="fteam">{t?.short_name ?? "Unknown team"}</span>
                        <span class="num fpct">{percent(r.p_win)}</span>
                      </summary>
                      {r.top_factors.length === 0 ? (
                        <p class="empty">No factor above the reporting threshold.</p>
                      ) : (
                        <ul class="flist">
                          {r.top_factors.map((f, k) => (
                            <li>
                              <span class="flabel">{f.label}</span>
                              <span class:list={["bar", f.direction]} aria-hidden="true">
                                <span style={`--w:${(f.magnitude * 100).toFixed(1)}%;--i:${k}`} />
                              </span>
                              <span class="fdir">
                                {f.direction === "positive" ? "Helps" : "Hurts"}
                              </span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </details>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <section class="wrap band" aria-labelledby="circuit-h">
    <div class="section-head">
      <p class="eyebrow">Circuit</p>
      <h2 id="circuit-h">{circuit.name}</h2>
    </div>
    <div class="circuit">
      <CircuitHistory history={history} circuit={circuit} season={race.season} />
      <CircuitCard circuit={circuit} />
    </div>
    <p class="note">
      Regulations era <span class="num">{race.regs_era}</span>, which bounds the history the model
      treats as comparable.
    </p>
    <!-- prettier-ignore -->
    <p class="note">Data version <span class="num">{meta.data_version}</span>, built <time datetime={meta.generated_at} data-local>{formatUtc(meta.generated_at)}</time>.</p>
  </section>
</BaseLayout>

<style>
  .head {
    display: grid;
    gap: var(--space-xl);
    padding-top: var(--space-xxl);
    padding-bottom: var(--space-lg);
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
      padding-top: var(--space-section);
    }
  }
  .title-block {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }
  .when {
    display: grid;
    gap: var(--space-xs);
  }
  .when :global(.sessions) {
    margin-top: var(--space-md);
  }

  .scores {
    margin-bottom: var(--space-xl);
  }
  .wide {
    min-width: 680px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .team {
    display: block;
    font-size: 12px;
    line-height: 1.33;
    font-weight: var(--weight-text);
    color: var(--colour-text-muted);
  }
  .note {
    margin-top: var(--space-md);
    font-size: 14px;
    line-height: 1.43;
    color: var(--colour-text-muted);
    max-width: 68ch;
  }

  /*
   * Snapshot toggle: two radios and a :has() rule, no script, and the keyboard
   * works for free. The white pill is one element that slides between the two
   * equal columns by transform; the incoming panel's rows rise into place.
   */
  .seg {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    margin: 0 0 var(--space-xl);
    padding: var(--space-xxs);
    border: 0;
    border-radius: var(--rounded-full);
    background: var(--colour-canvas-soft);
  }
  .seg::before {
    content: "";
    position: absolute;
    top: var(--space-xxs);
    bottom: var(--space-xxs);
    left: var(--space-xxs);
    width: calc(50% - var(--space-xxs));
    border-radius: var(--rounded-full);
    background: var(--colour-canvas);
    /* DESIGN.md's one soft-shadow exception: the active segment lifts off its track. */
    box-shadow: 0 1px 2px color-mix(in srgb, var(--colour-ink) 10%, transparent);
    transition: transform var(--motion-base) var(--motion-ease-standard);
  }
  .seg:has(input:nth-of-type(2):checked)::before {
    transform: translateX(100%);
  }
  .seg input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .seg label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--space-lg);
    border-radius: var(--rounded-full);
    font-weight: var(--weight-strong);
    color: var(--colour-text-muted);
    cursor: pointer;
    transition: color var(--motion-base) var(--motion-ease-standard);
  }
  .seg input:checked + label {
    color: var(--colour-ink);
  }
  .seg input:focus-visible + label {
    outline: 2px solid var(--colour-ink);
    outline-offset: 2px;
  }
  .wrap:has(#snap-post_qualifying:checked) .panel[data-snap="pre_weekend"],
  .wrap:has(#snap-pre_weekend:checked) .panel[data-snap="post_qualifying"] {
    display: none;
  }
  .panel {
    display: grid;
    gap: var(--space-md);
    animation: rise var(--motion-enter) var(--motion-ease-out) backwards;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    max-width: 78ch;
  }
  .revisions {
    font-size: 14px;
    line-height: 1.43;
    max-width: 78ch;
  }
  .revisions ol {
    margin: 0;
    padding-left: var(--space-lg);
    display: grid;
    gap: var(--space-sm);
  }
  .revisions .reason {
    margin-top: var(--space-xxs);
    color: var(--colour-text-muted);
  }

  .sub {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-xxl);
    max-width: 68ch;
  }

  .factors {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--colour-hairline);
  }
  .factors > li {
    border-bottom: 1px solid var(--colour-hairline);
  }
  .factors summary {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    width: auto;
    font-weight: var(--weight-text);
    align-items: center;
    gap: var(--space-sm);
    min-height: 48px;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--rounded-sm);
    cursor: pointer;
    font-size: 14px;
    transition: background-color var(--motion-quick) var(--motion-ease-out);
  }
  .factors summary:hover {
    background: var(--colour-canvas-soft);
  }
  .fname {
    font-weight: var(--weight-strong);
  }
  .fteam {
    font-size: 12px;
    color: var(--colour-text-muted);
  }
  .fpct {
    min-width: 6ch;
    text-align: right;
  }
  .flist {
    list-style: none;
    margin: 0 0 var(--space-md);
    padding: 0 var(--space-md);
    display: grid;
    gap: var(--space-sm);
  }
  .flist li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(80px, 160px) 6ch;
    align-items: center;
    gap: var(--space-sm);
    font-size: 14px;
    line-height: 1.43;
  }
  .flist .bar.negative > span {
    background: var(--colour-text-faint);
  }
  .fdir {
    font-size: 12px;
    font-weight: var(--weight-strong);
  }
  .empty {
    padding: 0 var(--space-md) var(--space-md);
    font-size: 14px;
    color: var(--colour-text-muted);
  }

  .circuit {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }
  @media (min-width: 900px) {
    .circuit {
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>
