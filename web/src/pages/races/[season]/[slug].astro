---
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import PositionDistribution from "../../../components/prediction/PositionDistribution.astro";
import ProbabilityTable from "../../../components/prediction/ProbabilityTable.astro";
import Provenance from "../../../components/prediction/Provenance.astro";
import TeamMarker from "../../../components/prediction/TeamMarker.astro";
import CircuitCard from "../../../components/race/CircuitCard.astro";
import CircuitHistory from "../../../components/race/CircuitHistory.astro";
import Countdown from "../../../components/race/Countdown.astro";
import SessionTimes from "../../../components/race/SessionTimes.astro";
import {
  circuitById,
  circuitHistoryFor,
  driverById,
  driversByWinProbability,
  loadDataset,
  predictionsForRace,
  raceById,
  teamById,
} from "../../../lib/data";
import { chanceInWords, driverName, logLoss, percent, position, score } from "../../../lib/format";
import type { Prediction } from "../../../lib/schema";
import { FACTOR_NOTE, describeModel } from "../../../lib/models";
import { BASELINE_FOR, SNAPSHOT_BLURB, SNAPSHOT_LABEL } from "../../../lib/snapshots";

/** What a before-practice prediction used, from the model that made it. */
function earlyCall(p: Prediction): string {
  return (
    `Qualifying and practice have not happened yet, so this prediction uses ` +
    `${describeModel(p.model_version, p.snapshot)}. It is weaker than the prediction after qualifying.`
  );
}

/** The favourite in one plain sentence: who, and how often they would win. */
function favouriteLine(rows: { driverId: number; p_win: number }[], name: (id: number) => string) {
  const top = rows[0];
  if (!top) return "";
  return `${name(top.driverId)} is the favourite, with ${chanceInWords(top.p_win)} to win.`;
}
import { formatUtc, isPast } from "../../../lib/time";

export async function getStaticPaths() {
  const { reference, predictions } = loadDataset();
  const withPredictions = new Set(predictions.map((p) => p.race_id));
  return reference.races
    .filter((r) => withPredictions.has(r.race_id))
    .map((r) => ({
      params: { season: String(r.season), slug: r.slug },
      props: { raceId: r.race_id },
    }));
}

const { raceId } = Astro.props;
const { reference, predictions, meta } = loadDataset();
const drivers = driverById(reference);
const teams = teamById(reference);
const circuits = circuitById(reference);
const race = raceById(reference).get(raceId)!;
const circuit = circuits.get(race.circuit_id)!;
const history = circuitHistoryFor(reference, raceId);

// Post-qualifying first when it exists: it is the sharper of the two, and the
// one a reader arriving on race day wants.
const snapshots = predictionsForRace(predictions, raceId);
const shown = snapshots[0]!;
const scoredWith = snapshots.find((s) => s.result !== null) ?? null;
const result = scoredWith?.result ?? null;
const now = new Date();
const started = isPast(race.starts_at, now);
const sessions =
  race.sessions.length > 0
    ? race.sessions
    : meta.next_race?.race_id === raceId
      ? meta.next_race.sessions
      : [];

const actualById = new Map((result?.drivers ?? []).map((d) => [d.driverId, d]));

// Which chances on this page have passed a test, said once and plainly. A
// points chance exists only on predictions made after it was added (§12).
const hasPoints = snapshots.some((s) => s.drivers.every((d) => d.p_points !== undefined));
const fieldIntro = hasPoints
  ? "Every driver's chance of winning, finishing on the podium and scoring points, plus their " +
    "chance of not finishing (DNF) and where they are likely to end up."
  : "Every driver's chance of winning and of finishing on the podium, plus their chance of not " +
    "finishing (DNF) and where they are likely to end up.";
const testStatus = hasPoints
  ? "Win chances and points chances have passed tests against past races. Points come from " +
    "their own model, not the race simulation, so they can disagree a little with the podium " +
    "chance. Podium chances were tested and are no better than a simple rule. The DNF chance " +
    "and the finishing order have not been tested on their own."
  : "Win chances have passed a test against past races. Podium chances were tested and are no " +
    "better than a simple rule. The DNF chance and the finishing order have not been tested on " +
    "their own. A top-ten chance was tested, found unreliable, and is no longer shown; " +
    "predictions made later carry a tested points chance instead.";

/** "A", "A and B", "A, B and C", from driver ids. */
function nameList(ids: number[]): string {
  const names = ids.map((id) => {
    const d = drivers.get(id);
    return d ? driverName(d) : `Driver ${id}`;
  });
  if (names.length <= 1) return names[0] ?? "";
  return `${names.slice(0, -1).join(", ")} and ${names[names.length - 1]}`;
}

/**
 * Why a snapshot has no log loss on this race, as a sentence, or "" when it
 * has one. Built here as one string so no line break can put a space before
 * the punctuation.
 */
function noLogLoss(r: NonNullable<Prediction["result"]>): string {
  if (r.log_loss_undefined === null) return "";
  const winner = r.drivers.find((d) => d.actual_position === 1)?.driverId;
  const who = winner === undefined ? "The winner" : nameList([winner]);
  const how =
    r.log_loss_undefined === "winner_not_in_field"
      ? `${who} won without being in this prediction's list of drivers`
      : `${who} won with a win chance published as 0.0%, to six decimal places`;
  return (
    `${how}, so the prediction gave the winner no chance at all and there is nothing to score. ` +
    "The score is left empty rather than filled with a made-up number. It still counts as a " +
    "missed winner, the Brier score charges the full miss, and the track record's average " +
    "leaves this race out and says so."
  );
}
// Every starter in finishing order, and every predicted driver. A driver the
// snapshot never listed, such as one returning to a pre-weekend field carried
// over from the previous race, gets a row with no probabilities beside it:
// the snapshot gave them none. Leaving them out would leave gaps in the
// order, or start the table at P2.
type TableRow = { driverId: number; predicted: Prediction["drivers"][number] | null };
const tableRows: TableRow[] = scoredWith
  ? [
      ...scoredWith.drivers.map((row) => ({ driverId: row.driverId, predicted: row })),
      ...(result?.unpredicted_starters ?? []).map((driverId) => ({ driverId, predicted: null })),
    ].sort((a, b) => {
      // Unclassified starters after the classified ones, and drivers who did
      // not start after everyone who did.
      const at = (id: number) =>
        actualById.get(id)?.actual_position ?? (actualById.has(id) ? 99 : 100);
      const pa = at(a.driverId);
      const pb = at(b.driverId);
      const wa = a.predicted?.p_win ?? -1;
      const wb = b.predicted?.p_win ?? -1;
      return pa - pb || wb - wa || a.driverId - b.driverId;
    })
  : [];
const scoreKey = scoredWith
  ? "Lower scores are better. Our score depends on the chance we gave the driver who won: " +
    `giving them 100% would score 0. The simple rule here is ${BASELINE_FOR[scoredWith.snapshot]}, ` +
    "and its score is worked out the same way, so the two can be compared."
  : "";
const tableNote =
  "Avg finish is where we expected the driver to finish, on average. Vs avg is how many places " +
  "better (+) or worse (−) they actually finished. A driver who did not finish has no position, " +
  "so no figure." +
  (result && result.unpredicted_starters.length > 0
    ? " A driver who was not in this prediction's list of drivers was given no chances, so has none to show."
    : "");

const title = `${race.season} ${race.name} — win and podium chances`;
const description = result
  ? `How Sector 4's ${race.season} ${race.name} prediction turned out: score ${logLoss(result.log_loss).toLowerCase()}, ` +
    `${result.podium_hits} of 3 podium picks right, winner ${result.winner_hit ? "picked" : "missed"}.`
  : `Win, podium and DNF chances for all ${shown.drivers.length} drivers at the ` +
    `${race.season} ${race.name}, with the factors behind each.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SportsEvent",
    name: `${race.season} ${race.name}`,
    startDate: race.starts_at,
    eventStatus: "https://schema.org/EventScheduled",
    location: {
      "@type": "Place",
      name: circuit.name,
      address: {
        "@type": "PostalAddress",
        addressLocality: circuit.locality,
        addressCountry: circuit.country,
      },
      geo: { "@type": "GeoCoordinates", latitude: circuit.lat, longitude: circuit.lng },
    },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/races/${race.season}/${race.slug}.png`}
  imageAlt={`${race.season} ${race.name}: the three drivers most likely to win, with their chances.`}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: "Track record", path: "/track-record/" },
    { name: `${race.season} ${race.name}`, path: `/races/${race.season}/${race.slug}/` },
  ]}
>
  <section class="wrap head">
    <div class="title-block">
      <p class="kicker">
        {!started && <span class="badge badge-accent">Upcoming</span>}
        <span class="muted body-sm">
          Round {race.round} of {race.season}
        </span>
      </p>
      <h1>{race.name}</h1>
      <p class="lead">
        {circuit.name}, {circuit.locality}, {circuit.country}
      </p>
    </div>

    <div class="card-soft when">
      {started ? (
        <>
          <p class="h3">Race complete</p>
          <p class="muted body-sm">
            Started{" "}
            <time datetime={race.starts_at} data-local>
              {formatUtc(race.starts_at)}
            </time>
          </p>
        </>
      ) : (
        <>
          <p class="body-sm muted">Race starts in</p>
          <Countdown startsAt={race.starts_at} />
          {sessions.length > 0 ? (
            <SessionTimes sessions={sessions} />
          ) : (
            <p class="body-sm">
              Race{" "}
              <time datetime={race.starts_at} data-local>
                {formatUtc(race.starts_at)}
              </time>
            </p>
          )}
        </>
      )}
    </div>
  </section>

  {result && scoredWith && (
    <section class="wrap band" aria-labelledby="result-h">
      <div class="section-head">
        <p class="eyebrow">Result</p>
        <h2 id="result-h">Predicted against actual.</h2>
        <p>
          Scored using the {SNAPSHOT_LABEL[scoredWith.snapshot].toLowerCase()} prediction, published
          before the race started. Nothing here is recalculated after the fact.
        </p>
      </div>
      <dl class="figures scores">
        <div class="rise" style="--i:0">
          <dt>Our score</dt>
          <dd class="num">{logLoss(result.log_loss)}</dd>
        </div>
        {result.baseline && (
          <div class="rise" style="--i:1">
            <dt>Simple rule</dt>
            <dd class="num">{score(result.baseline.log_loss)}</dd>
          </div>
        )}
        <div class="rise" style="--i:2">
          <dt>Brier score</dt>
          <dd class="num">{score(result.brier)}</dd>
        </div>
        <div class="rise" style="--i:3">
          <dt>Picked the winner</dt>
          <dd>{result.winner_hit ? "Yes" : "No"}</dd>
        </div>
        <div class="rise" style="--i:4">
          <dt>Podium picks right</dt>
          <dd class="num">{result.podium_hits} of 3</dd>
        </div>
      </dl>
      <p class="body-sm muted score-key">
        {scoreKey} <a href="/track-record/">The track record</a> explains every column.
      </p>
      {result.log_loss_undefined && (
        <p class="notice">
          <span class="badge badge-ink">No score</span>
          <span>{noLogLoss(result)}</span>
        </p>
      )}

      <div class="scroller">
        <table class="table wide">
          <caption class="sr-only">
            Every driver's finishing position beside the chances we gave before the race.
          </caption>
          <thead>
            <tr>
              <th scope="col">Pos</th>
              <th scope="col">Driver</th>
              <th scope="col" class="n">
                Win
              </th>
              <th scope="col" class="n">
                Podium
              </th>
              <th scope="col" class="n">
                Avg finish
              </th>
              <th scope="col" class="n">
                vs avg
              </th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {tableRows.map(({ driverId, predicted: row }, i) => {
              const d = drivers.get(driverId);
              const t = row ? teams.get(row.team_entity_id) : undefined;
              const a = actualById.get(driverId);
              const pos = a?.actual_position ?? null;
              const delta = pos === null || !row ? null : row.expected_position - pos;
              return (
                <tr class="rise" style={`--i:${i}`}>
                  <td class="num dim">{pos === null ? "—" : pos}</td>
                  <th scope="row">
                    <span class="who">
                      {t ? (
                        <TeamMarker colour={t.colour_on_light} name={t.name} />
                      ) : (
                        <span class="no-marker" aria-hidden="true" />
                      )}
                      <span>
                        {d ? driverName(d) : `Driver ${driverId}`}
                        <span class="team">
                          {row ? (t?.short_name ?? "Unknown team") : "Not in this prediction"}
                        </span>
                      </span>
                    </span>
                  </th>
                  <td class="n num">{row ? percent(row.p_win) : "—"}</td>
                  <td class="n num">{row ? percent(row.p_podium) : "—"}</td>
                  <td class="n num dim">{row ? position(row.expected_position) : "—"}</td>
                  <td class="n num">
                    {delta === null
                      ? "—"
                      : `${delta > 0 ? "+" : delta < 0 ? "−" : ""}${position(Math.abs(delta))}`}
                  </td>
                  <td class="dim">
                    {a?.status ??
                      (result?.predicted_non_starters.includes(driverId)
                        ? "Did not start"
                        : "Unknown")}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="note">{tableNote}</p>
    </section>
  )}

  <section class="wrap band" aria-labelledby="field-h">
    <div class="section-head">
      <p class="eyebrow">Prediction</p>
      <h2 id="field-h">Full field</h2>
      <p>{fieldIntro}</p>
      <p class="body-sm muted">{testStatus}</p>
    </div>

    <details class="read disclosure">
      <summary>How to read these numbers</summary>
      <div class="prose body-sm">
        <p>
          A 28% chance to win means that if this race could be run 100 times, we would expect the
          driver to win about 28 of them. So even a 70% favourite should lose about 3 races in 10.
          Missing some winners is what honest odds look like, not a sign they are wrong.
        </p>
        <p>
          The win chances have passed a test against past races. So have the points chances, on
          predictions that carry them: they come from their own model, trained directly on scoring
          points. The podium and finishing-order figures are worked out from the win chances by
          simulating the race many thousands of times. The simulation never retires a car, so it is
          surest about the front of the field and least sure further back. Podium chances were
          tested and are no better than a simple rule. A top-ten chance from the simulation did
          worse than a simple rule and is no longer shown. The DNF chance comes from a separate
          model that has not been tested.
        </p>
      </div>
    </details>

    {snapshots.length > 1 && (
      <fieldset class="seg" style={`--n:${snapshots.length}`}>
        <legend class="sr-only">Prediction</legend>
        {snapshots.map((s, i) => (
          <>
            <input
              type="radio"
              name="snapshot"
              id={`snap-${s.snapshot}`}
              value={s.snapshot}
              checked={i === 0}
            />
            <label for={`snap-${s.snapshot}`}>{SNAPSHOT_LABEL[s.snapshot]}</label>
          </>
        ))}
      </fieldset>
    )}

    <div class="panels">
      {snapshots.map((s) => {
        const rows = driversByWinProbability(s);
        return (
          <div class="panel" data-snap={s.snapshot}>
            <p class="meta body-sm">
              <span class="badge badge-soft">{SNAPSHOT_LABEL[s.snapshot]}</span>
              <span>
                {SNAPSHOT_BLURB[s.snapshot]} Compared with the {BASELINE_FOR[s.snapshot]} rule.
              </span>
            </p>
            <Provenance
              generatedAt={s.generated_at}
              revision={s.revision}
              commit={s.published_commit}
              model={s.model_version}
              data={s.data_version}
            />
            <p class="fav">{favouriteLine(rows, (id) => nameList([id]))}</p>
            {s.snapshot === "pre_weekend" && (
              <p class="notice">
                <span class="badge badge-ink">Early call</span>
                <span>
                  {earlyCall(s)} The <a href="/methodology/">methodology page</a> explains both.
                </span>
              </p>
            )}
            {s.result &&
              (s.result.unpredicted_starters.length > 0 ||
                s.result.predicted_non_starters.length > 0) && (
                <p class="notice">
                  <span class="badge badge-ink">Field change</span>
                  <span>
                    {s.result.unpredicted_starters.length > 0 &&
                      `${nameList(s.result.unpredicted_starters)} started the race without being in this prediction's list of drivers${s.snapshot === "pre_weekend" ? ", which was copied from the previous race's starters" : ""}. `}
                    {s.result.predicted_non_starters.length > 0 &&
                      `${nameList(s.result.predicted_non_starters)} ${s.result.predicted_non_starters.length === 1 ? "was" : "were"} in the list and did not start, so ${s.result.predicted_non_starters.length === 1 ? "was" : "were"} left out when this prediction was scored, and everyone else's chances were scaled up to add back to 100%.`}
                  </span>
                </p>
              )}
            {s.result?.log_loss_undefined && s !== scoredWith && (
              <p class="notice">
                <span class="badge badge-ink">No score</span>
                <span>{noLogLoss(s.result)}</span>
              </p>
            )}
            {s.revisions.length > 1 && (
              <details class="revisions disclosure">
                <summary>
                  Revision history: {s.revisions.length} published, revision {s.revision} counts
                </summary>
                <ol>
                  {s.revisions.map((r) => (
                    <li>
                      <p>
                        <strong>Revision {r.revision}.</strong>{" "}
                        {r.effective
                          ? "The one that counts."
                          : r.late
                            ? "Published after the session started, so not scored."
                            : "Superseded."}
                      </p>
                      <Provenance
                        generatedAt={r.generated_at}
                        revision={r.revision}
                        commit={r.published_commit}
                      />
                      {r.reason && <p class="reason">{r.reason}</p>}
                    </li>
                  ))}
                </ol>
              </details>
            )}

            <div class="scroller">
              <ProbabilityTable
                rows={rows}
                drivers={drivers}
                teams={teams}
                caption={`${SNAPSHOT_LABEL[s.snapshot]} chances for all ${rows.length} drivers, most likely winner first.`}
              />
            </div>

            <div class="sub">
              <h3>Finishing order</h3>
              <p class="muted body-sm">
                Where each driver finished across thousands of simulated races, one column per
                position. Taller means more often. The simulation does not include retirements:
                every car is placed somewhere, and the chance of not finishing is the DNF column
                above. It is the same simulation that produced the top-ten chance, which tested
                worse than a simple rule, so read the spread further down the order with caution.
              </p>
            </div>
            <PositionDistribution rows={rows} drivers={drivers} teams={teams} />

            <div class="sub">
              <h3>What is behind each driver's chance</h3>
              <p class="muted body-sm">
                How much each input pushed the driver's win chance up or down. These are relative
                weights, not lap times.
              </p>
              {FACTOR_NOTE[s.model_version] && (
                <p class="muted body-sm">{FACTOR_NOTE[s.model_version]}</p>
              )}
            </div>
            <ul class="factors">
              {rows.map((r, i) => {
                const d = drivers.get(r.driverId);
                const t = teams.get(r.team_entity_id);
                return (
                  <li>
                    <details class="disclosure" open={i < 3}>
                      <summary>
                        <span class="fname">{d ? driverName(d) : `Driver ${r.driverId}`}</span>
                        <span class="fteam">{t?.short_name ?? "Unknown team"}</span>
                        <span class="num fpct">{percent(r.p_win)}</span>
                      </summary>
                      {r.top_factors.length === 0 ? (
                        <p class="empty">No single input made much difference.</p>
                      ) : (
                        <ul class="flist">
                          {r.top_factors.map((f, k) => (
                            <li>
                              <span class="flabel">{f.label}</span>
                              <span class:list={["bar", f.direction]} aria-hidden="true">
                                <span style={`--w:${(f.magnitude * 100).toFixed(1)}%;--i:${k}`} />
                              </span>
                              <span class="fdir">
                                {f.direction === "positive" ? "Helps" : "Hurts"}
                              </span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </details>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <section class="wrap band" aria-labelledby="circuit-h">
    <div class="section-head">
      <p class="eyebrow">Circuit</p>
      <h2 id="circuit-h">{circuit.name}</h2>
    </div>
    <div class="circuit">
      <CircuitHistory history={history} circuit={circuit} season={race.season} />
      <CircuitCard circuit={circuit} />
    </div>
    <!-- prettier-ignore -->
    <p class="note">Data version <span class="num">{meta.data_version}</span>, built <time datetime={meta.generated_at} data-local>{formatUtc(meta.generated_at)}</time>.</p>
  </section>
</BaseLayout>

<style>
  .head {
    display: grid;
    gap: var(--space-xl);
    padding-top: var(--space-xxl);
    padding-bottom: var(--space-lg);
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
      padding-top: var(--space-section);
    }
  }
  .title-block {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }
  .when {
    display: grid;
    gap: var(--space-xs);
  }
  .when :global(.sessions) {
    margin-top: var(--space-md);
  }

  .scores {
    margin-bottom: var(--space-sm);
  }
  /* The key reads as part of the figures above it, clear of the table. */
  .score-key {
    max-width: 68ch;
    margin-bottom: var(--space-xl);
  }
  /* The no-score notice sits between the key and the table: close to the
     figures it explains, and clear of the table. Whether these margins
     collapse or add, the gap above comes out at --space-md. */
  .score-key + .notice {
    margin: calc(var(--space-md) - var(--space-xl)) 0 var(--space-xl);
  }
  .wide {
    min-width: 680px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  /* Keeps a driver with no team in this snapshot aligned with the rest. */
  .no-marker {
    width: 14px;
    flex: none;
  }
  .team {
    display: block;
    font-size: 12px;
    line-height: 1.33;
    font-weight: var(--weight-text);
    color: var(--colour-text-muted);
  }
  .note {
    margin-top: var(--space-md);
    font-size: 14px;
    line-height: 1.43;
    color: var(--colour-text-muted);
    max-width: 68ch;
  }

  /*
   * Snapshot toggle: two radios and a :has() rule, no script, and the keyboard
   * works for free. The white pill is one element that slides between the two
   * equal columns by transform; the incoming panel's rows rise into place.
   */
  .seg {
    position: relative;
    display: inline-grid;
    grid-template-columns: repeat(var(--n, 2), 1fr);
    margin: 0 0 var(--space-xl);
    padding: var(--space-xxs);
    border: 0;
    border-radius: var(--rounded-full);
    background: var(--colour-canvas-soft);
