---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Countdown from "../components/race/Countdown.astro";
import SessionTimes from "../components/race/SessionTimes.astro";
import TeamMarker from "../components/prediction/TeamMarker.astro";
import ProbabilityBar from "../components/prediction/ProbabilityBar.astro";
import Provenance from "../components/prediction/Provenance.astro";
import {
  circuitById,
  driverById,
  driversByWinProbability,
  loadDataset,
  logLossSummary,
  preferredSnapshot,
  raceById,
  scoredPredictions,
  teamById,
} from "../lib/data";
import { chanceInWords, driverName, logLoss, percent, score } from "../lib/format";
import { BASELINE_FOR, SNAPSHOT_LABEL, SERIES, SCORED_SUMMARY_MINIMUM } from "../lib/snapshots";

const { reference, predictions, meta } = loadDataset();
const drivers = driverById(reference);
const teams = teamById(reference);
const races = raceById(reference);
const circuits = circuitById(reference);

const next = meta.next_race;
const nextRace = next ? races.get(next.race_id) : undefined;
const nextCircuit = next ? circuits.get(next.circuit_id) : undefined;
const nextPred = next ? preferredSnapshot(predictions, next.race_id) : undefined;
const contenders = nextPred ? driversByWinProbability(nextPred).slice(0, 5) : [];
const maxWin = contenders[0]?.p_win ?? 1;
const favourite = contenders[0] ? drivers.get(contenders[0].driverId) : undefined;
// One string, so no line break in the markup can put a space before a comma.
const favouriteLine =
  favourite && contenders[0]
    ? `${driverName(favourite)} is the favourite, with ${chanceInWords(contenders[0].p_win)} ` +
      "to win. A favourite still loses whenever that chance does not come off."
    : "";

// Scoring starts with the earliest race that has a prediction at all: every
// race before it was run before anything was published, so there is nothing
// of ours to score.
const firstPredicted = [...predictions].sort((a, b) => a.season - b.season || a.round - b.round)[0];
const firstRace = firstPredicted ? races.get(firstPredicted.race_id) : undefined;

// The two snapshots are different models against different baselines, so
// they are summarised side by side and never averaged together.
const scored = scoredPredictions(predictions);
const last = scored[0];
const scoreKey = last
  ? "Lower scores are better. The score depends on the chance we gave the driver who won: " +
    `giving them 100% would score 0. The simple rule here is ${BASELINE_FOR[last.snapshot]}.`
  : "";
const lastRace = last ? races.get(last.race_id) : undefined;
const lastTop = last ? driversByWinProbability(last).slice(0, 3) : [];
const actualById = new Map((last?.result?.drivers ?? []).map((d) => [d.driverId, d]));

const series = SERIES.map((snapshot) => {
  const rows = scored.filter((p) => p.snapshot === snapshot);
  const ll = logLossSummary(rows);
  return {
    snapshot,
    n: rows.length,
    wins: rows.filter((p) => p.result!.winner_hit).length,
    podiums: rows.reduce((a, p) => a + p.result!.podium_hits, 0),
    logLoss: ll.mean,
    // Races with no defined log loss: left out of the average, and said so.
    leftOut:
      ll.undefined === 0
        ? ""
        : `Leaves out ${ll.undefined === 1 ? "one race" : `${ll.undefined} races`} with no ` +
          "score, where the prediction gave the winner no chance at all.",
  };
}).filter((s) => s.n > 0);
const summarised = series.filter((s) => s.n >= SCORED_SUMMARY_MINIMUM);
// One string, so no line break in the markup can put a space before a comma.
const soFar = series.map((s) => `${s.n} ${SNAPSHOT_LABEL[s.snapshot].toLowerCase()}`).join(", ");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Sector 4",
    url: Astro.site!.href,
    description: "Probabilistic Formula 1 race predictions, scored in public.",
  },
];
---

<BaseLayout
  title="Sector 4 — F1 race predictions, scored in public"
  description={
    next
      ? `Win, podium and top-ten probabilities for the ${next.season} ${next.name}, plus an auditable record of how every past prediction turned out.`
      : "Win, podium and top-ten probabilities for Formula 1 races, plus an auditable record of how every prediction turned out."
  }
  jsonLd={jsonLd}
>
  <section class="wrap hero">
    {next && (
      <p class="kicker">
        <span class="badge badge-accent">Next race</span>
        <span class="muted body-sm">
          Round {next.round} of {next.season}, {next.name}
        </span>
      </p>
    )}
    <h1 class="display">Race predictions, scored in public.</h1>
    <p class="lead">
      Every driver's chance of winning, finishing on the podium and finishing in the top ten.
      Published before practice and again after qualifying, then checked against the result. The
      misses stay on the record.
    </p>
    <div class="actions">
      {nextRace && (
        <a class="btn btn-primary" href={`/races/${nextRace.season}/${nextRace.slug}/`}>
          See the {nextRace.name}
        </a>
      )}
      <a class="btn btn-soft" href="/methodology/">
        How it works
      </a>
    </div>
  </section>

  {next && nextRace && nextPred && (
    <section class="wrap band next" aria-labelledby="next-h">
      <div class="card-soft next-card">
        <div class="when">
          <p class="eyebrow">
            Round {next.round}, {next.season}
          </p>
          <h2 id="next-h" class="h3">
            {next.name}
          </h2>
          <p class="muted where">
            {nextCircuit?.name}, {nextCircuit?.locality}, {nextCircuit?.country}
          </p>
          <p class="body-sm label-cd">Race starts in</p>
          <Countdown startsAt={next.starts_at} />
          <SessionTimes sessions={next.sessions} />
        </div>

        <div class="card who-wins">
          <div class="panel-head">
            <h3 class="title">Most likely winner</h3>
            <span class="badge badge-soft">{SNAPSHOT_LABEL[nextPred.snapshot]}</span>
          </div>
          <ol class="contenders">
            {contenders.map((c, i) => {
              const d = drivers.get(c.driverId)!;
              const t = teams.get(c.team_entity_id)!;
              return (
                <li class="rise" style={`--i:${i}`}>
                  <TeamMarker colour={t.colour_on_light} name={t.name} />
                  <span class="cname">
                    {driverName(d)}
                    <span class="cteam">{t.short_name}</span>
                  </span>
                  <span class="cbar">
                    <ProbabilityBar value={c.p_win} columnMax={maxWin} index={i} />
                  </span>
                  <span class="num cpct">{percent(c.p_win)}</span>
                </li>
              );
            })}
          </ol>
          {favouriteLine && <p class="body-sm">{favouriteLine}</p>}
          {nextPred.snapshot === "pre_weekend" && (
            <p class="body-sm muted reduced">
              This early call cannot see anything from this weekend yet. It gets sharper after
              qualifying.
            </p>
          )}
          <Provenance
            generatedAt={nextPred.generated_at}
            revision={nextPred.revision}
            commit={nextPred.published_commit}
          />
          <a class="btn btn-outline" href={`/races/${nextRace.season}/${nextRace.slug}/`}>
            Full field and factors
          </a>
        </div>
      </div>
    </section>
  )}

  <section class="wrap band" aria-labelledby="record-h">
    {!last ? (
      <div class="card-soft empty">
        <p class="eyebrow">Track record</p>
        <h2 id="record-h" class="h2">
          {firstRace
            ? `Scoring begins with the ${firstRace.name}.`
            : "Scoring begins with the first published prediction."}
        </h2>
        <p class="lead empty-lead">
          {firstRace
            ? `Round ${firstRace.round} is the first race with a prediction published before the weekend began. Nothing is scored until it has run.`
            : "Nothing is scored until a race with a published prediction has run."}
        </p>
        <ul class="coming">
          <li class="rise" style="--i:0">
            <strong>How each prediction scored.</strong> A score for how much chance it gave the
            actual winner, next to the score of a simple rule that knew the same things: the
            championship order before practice, the qualifying order after qualifying.
          </li>
          <li class="rise" style="--i:1">
            <strong>What it called.</strong> Whether the winner was the favourite, how many podium
            places it caught, and the predicted top three next to where they finished.
          </li>
          <li class="rise" style="--i:2">
            <strong>The season so far.</strong> Winners picked, podium places and the average score,
            once four races are scored. Fewer than that is too few to summarise.
          </li>
        </ul>
        <a class="btn btn-outline" href="/track-record/">
          Open the track record
        </a>
      </div>
    ) : (
      <div class="scored">
        <div class="section-head">
          <p class="eyebrow">Last scored race</p>
          <h2 id="record-h">
            {lastRace?.name}, {SNAPSHOT_LABEL[last.snapshot].toLowerCase()}.
          </h2>
        </div>
        <div class="receipt">
          <div class="scroller">
            <table class="table">
              <caption class="sr-only">
                Our three favourites to win, and where each finished.
              </caption>
              <thead>
                <tr>
                  <th scope="col">Our top three</th>
                  <th scope="col" class="n">
                    Win chance
                  </th>
                  <th scope="col" class="n">
                    Finished
                  </th>
                  <th scope="col">Outcome</th>
                </tr>
              </thead>
              <tbody>
                {lastTop.map((c, i) => {
                  const d = drivers.get(c.driverId)!;
                  const a = actualById.get(c.driverId);
                  const pos = a?.actual_position ?? null;
                  return (
                    <tr class="rise" style={`--i:${i}`}>
                      <th scope="row">{driverName(d)}</th>
                      <td class="n num">{percent(c.p_win)}</td>
                      <td class="n num">{pos === null ? (a?.status ?? "—") : `P${pos}`}</td>
                      <td>{pos !== null && pos <= 3 ? "Podium" : "Missed the podium"}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <div class="receipt-scores">
            <dl class="figures">
              <div>
                <dt>Our score</dt>
                <dd class="num">{logLoss(last.result!.log_loss)}</dd>
              </div>
              {last.result!.baseline && (
                <div>
                  <dt>Simple rule</dt>
                  <dd class="num">{score(last.result!.baseline.log_loss)}</dd>
                </div>
              )}
              <div>
                <dt>Picked the winner</dt>
                <dd>{last.result!.winner_hit ? "Yes" : "No"}</dd>
              </div>
              <div>
                <dt>Podium picks right</dt>
                <dd class="num">{last.result!.podium_hits} of 3</dd>
              </div>
            </dl>
            <p class="body-sm muted score-key">{scoreKey}</p>
          </div>
        </div>

        {summarised.length === 0 ? (
          <p class="notice season-wait">
            <span class="badge badge-ink">Season</span>
            <span>
              Season figures appear once four races are scored for each prediction. So far: {soFar}.
            </span>
          </p>
        ) : (
          summarised.map((s) => (
            <div class="season">
              <h3 class="title">{SNAPSHOT_LABEL[s.snapshot]}, season so far</h3>
              <dl class="figures">
                <div>
                  <dt>Races scored</dt>
                  <dd class="num">{s.n}</dd>
                </div>
                <div>
                  <dt>Winners picked</dt>
                  <dd class="num">
                    {s.wins} of {s.n}
                  </dd>
                </div>
                <div>
                  <dt>Podium places</dt>
                  <dd class="num">
                    {s.podiums} of {s.n * 3}
                  </dd>
                </div>
                <div>
                  <dt>Average score</dt>
                  <dd class="num">{s.logLoss === null ? "—" : score(s.logLoss)}</dd>
                </div>
              </dl>
              {s.leftOut && <p class="body-sm muted">{s.leftOut}</p>}
            </div>
          ))
        )}
        <p>
          <a class="btn btn-soft" href="/track-record/">
            Every prediction, including the misses
          </a>
        </p>
      </div>
    )}
  </section>

  <section class="wrap band how" aria-labelledby="how-h">
    <div class="section-head">
      <p class="eyebrow">How it works</p>
      <h2 id="how-h">Published first, scored after.</h2>
    </div>
    <div class="cards">
      <a class="card rise" style="--i:0" href="/methodology/">
        <h3 class="h4">Two predictions per race.</h3>
        <p class="muted">
          One before practice, from the championship standings alone. One after qualifying, once we
          know where everyone starts. Each is scored on its own, never averaged together.
        </p>
      </a>
      <a class="card rise" style="--i:1" href="/methodology/">
        <h3 class="h4">Compared with a simple rule.</h3>
        <p class="muted">
          Every race is scored next to a rule anyone could use, such as backing drivers by where
          they qualified. Tested on this season's first fourteen races, the model did not do clearly
          better than that rule, and we say so.
        </p>
      </a>
      <a class="card rise" style="--i:2" href="/track-record/">
        <h3 class="h4">Nothing is rewritten.</h3>
        <p class="muted">
          Every prediction is saved in public before the session starts. A correction is added
          beside the original, never over it, and only one published in time is ever scored.
        </p>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-lg);
    padding-top: var(--space-xxl);
    padding-bottom: var(--space-xl);
  }
  @media (min-width: 1024px) {
    .hero {
      padding-top: var(--space-section);
    }
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-xs);
  }
  .hero h1 {
    max-width: 14ch;
  }
  .hero .lead {
    max-width: 44ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }

  .next {
    padding-top: var(--space-lg);
  }
  .next-card {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 900px) {
    .next-card {
      grid-template-columns: 1fr 1.1fr;
      align-items: start;
    }
  }
  .when {
    display: grid;
    gap: var(--space-xs);
  }
  .where {
    margin-bottom: var(--space-lg);
  }
  .label-cd {
    color: var(--colour-text-muted);
  }
  .when :global(.sessions) {
    margin-top: var(--space-lg);
  }
  .who-wins {
    display: grid;
    gap: var(--space-lg);
  }
  .panel-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
  }
  .contenders {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }
  .contenders li {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) 6ch;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
  }
  /* Narrow: the bar takes its own line under the name rather than squeezing it. */
  .cbar {
    grid-column: 2 / -1;
    grid-row: 2;
  }
  @media (min-width: 480px) {
    .contenders li {
      grid-template-columns: 14px minmax(0, 1.3fr) minmax(0, 1fr) 6ch;
    }
    .cbar {
      grid-column: auto;
      grid-row: auto;
    }
  }
  .cname {
    font-weight: var(--weight-strong);
    line-height: 1.25;
  }
  .cteam {
    display: block;
    font-size: 12px;
    line-height: 1.33;
    font-weight: var(--weight-text);
    color: var(--colour-text-muted);
  }
  .cpct {
    text-align: right;
    font-weight: var(--weight-strong);
  }
  .who-wins .btn {
    justify-self: start;
  }

  .empty {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-lg);
  }
  @media (min-width: 900px) {
    .empty {
      padding: var(--space-xxl);
    }
  }
  .empty h2 {
    max-width: 20ch;
  }
  .empty-lead {
    max-width: 52ch;
  }
  .coming {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }
  @media (min-width: 900px) {
    .coming {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .coming li {
    background: var(--colour-canvas);
    border-radius: var(--rounded-sm);
    padding: var(--space-md);
    font-size: 14px;
    line-height: 1.43;
    color: var(--colour-text-muted);
  }
  .coming strong {
    display: block;
    margin-bottom: var(--space-xxs);
    color: var(--colour-ink);
    font-size: 16px;
  }
  .empty .btn {
    justify-self: start;
  }

  .scored {
    display: grid;
    gap: var(--space-xl);
  }
  .receipt {
    display: grid;
    gap: var(--space-lg);
  }
  @media (min-width: 900px) {
    .receipt {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
    .receipt .figures {
      grid-template-columns: 1fr 1fr;
    }
  }
  .receipt-scores {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }
  .season {
    display: grid;
    gap: var(--space-md);
  }

  .cards {
    display: grid;
    gap: var(--space-md);
  }
  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cards .card {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }
</style>
