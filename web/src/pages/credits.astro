---
import BaseLayout from "../components/layout/BaseLayout.astro";
import credits from "../data/credits.json";
import { loadDataset } from "../lib/data";

const { reference } = loadDataset();
const withOutlines = reference.circuits.filter((c) => c.track_path !== null).length;

const REPO = "https://github.com/swayyaam/sector4/blob/main";
const DATA_LICENSE_URL = `${REPO}/DATA_LICENSE.md`;
const LICENSE_URL = `${REPO}/LICENSE`;

const groups = [...new Set(credits.sources.map((s) => s.kind))].map((kind) => ({
  kind,
  items: credits.sources.filter((s) => s.kind === kind),
}));
---

<BaseLayout
  title="Credits"
  description="Every dataset, typeface and circuit outline Sector 4 is built on, with its licence and what it is used for."
  image="/og/credits.png"
  breadcrumbs={[{ name: "Credits", path: "/credits/" }]}
>
  <section class="wrap page-hero">
    <p class="eyebrow">Credits</p>
    <h1>Sources and licences.</h1>
    <p class="lead">
      None of this is original data. Everything below was made by somebody else and published under
      terms that allow it to be used here.
    </p>
  </section>

  {groups.map((group) => (
    <section class="wrap band" aria-labelledby={`g-${group.kind}`}>
      <h2 id={`g-${group.kind}`} class="h3 group-h">
        {group.kind}
      </h2>
      <ul class="sources">
        {group.items.map((s, i) => (
          <li class="card rise" style={`--i:${i}`}>
            <h3 class="title">
              <a href={s.url} rel="noopener">
                {s.title}
              </a>
            </h3>
            <p class="body-sm muted">{s.author}</p>
            <p class="use">{s.used_for}</p>
            <p>
              <a class="btn btn-soft lic" href={s.licence_url} rel="noopener">
                {s.licence}
              </a>
            </p>
            {s.notice && <p class="body-sm muted">{s.notice}</p>}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="wrap band chapter" aria-labelledby="means-h">
    <h2 id="means-h" class="h3">
      What that means for this project.
    </h2>
    <div class="prose">
      <p>
        The current season's data reaches this site under CC BY-NC-SA 4.0. Those terms are not
        severable from the rest of the dataset, so Sector 4 is a non-commercial project and stays
        one: no advertising, no paid tier, no data resale. Anything built on it inherits the same
        terms.
      </p>
      <div class="callout">
        <p>
          <strong>Formula 1's own timing data is stricter still.</strong> It is copyright Formula
          One World Championship Limited, licensed for personal and non-commercial use, and may not
          be republished without written consent. It is used to fit the model and never shown here.
          No lap time, sector time, telemetry channel or weather reading from that source appears on
          this site or in the repository.
        </p>
      </div>
      <p>
        <a href={DATA_LICENSE_URL} rel="noopener">
          DATA_LICENSE.md
        </a>{" "}
        quotes the full terms for every source from that source's own licence document, and{" "}
        <a href={LICENSE_URL} rel="noopener">
          LICENSE
        </a>{" "}
        covers the code. Share-alike reaches the data and the outputs derived from it, not the
        software that reads them.
      </p>
      <p>
        Circuit outlines are drawn from the f1-circuits geometry for{" "}
        <span class="num">{withOutlines}</span> of the{" "}
        <span class="num">{reference.circuits.length}</span> circuits in the reference data. A
        circuit without geometry renders no map rather than an approximation of one.
      </p>
      <p>
        No image, logo or mark belonging to the Formula 1 companies, to F1 TV, or to any team is
        used anywhere on this site. The team colours are plain hex values used as data markers, and
        every one of them appears beside a text label so the colour is never doing the work alone.
      </p>
      <p class="body-sm muted">{credits.note}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .group-h {
    margin-bottom: var(--space-lg);
  }
  .sources {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }
  @media (min-width: 768px) {
    .sources {
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    }
  }
  .sources li {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }
  .use {
    margin: var(--space-xs) 0;
  }
  .lic {
    min-height: 36px;
    font-size: 14px;
  }
</style>
