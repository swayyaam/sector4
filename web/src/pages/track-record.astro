---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { loadDataset, logLossSummary, raceById, predictionsForRace } from "../lib/data";
import { logLoss, score } from "../lib/format";
import {
  BASELINE_FOR,
  BASELINE_PLAIN,
  SCORED_SUMMARY_MINIMUM,
  SERIES,
  SNAPSHOT_LABEL,
  type Snapshot,
} from "../lib/snapshots";
import { formatUtc } from "../lib/time";

const { reference, predictions, meta } = loadDataset();
const races = raceById(reference);
const byRound = (a: { season: number; round: number }, b: { season: number; round: number }) =>
  a.season - b.season || a.round - b.round;

// Predicted but not yet run. Listed so the record cannot be read as a
// selection of the races that happened to go well.
const pending = predictions
  .filter((p) => p.result === null)
  .filter((p, i, all) => all.findIndex((q) => q.race_id === p.race_id) === i)
  .sort(byRound);

// The first race anything was published for: every race before it ran before
// there was a prediction to score.
const firstPredicted = [...predictions].sort(byRound)[0];
const firstRace = firstPredicted ? races.get(firstPredicted.race_id) : undefined;

/**
 * The two snapshots are kept apart, always.
 *
 * They are different models judged against different baselines: post-qualifying
 * sees the qualifying order and practice pace and is measured against
 * qualifying order; pre-weekend sees neither and is measured against
 * championship order. Pooling them would produce an average that describes
 * neither, and would flatter the weaker of the two by mixing it with the
 * stronger.
 */
function series(snapshot: Snapshot) {
  const scored = predictions
    .filter((p) => p.snapshot === snapshot && p.result !== null)
    .sort((a, b) => byRound(b, a));
  const n = scored.length;
  const ll = logLossSummary(scored);
  // A model can be replaced mid-season. Every row stays as published, and the
  // table says which model made which rows rather than letting them blur.
  const byModel = new Map<string, number[]>();
  for (const p of [...scored].sort(byRound)) {
    byModel.set(p.model_version, [...(byModel.get(p.model_version) ?? []), p.round]);
  }
  const modelNote =
    byModel.size < 2
      ? ""
      : "This table covers more than one model: " +
        [...byModel.entries()]
          .map(
            ([v, rounds]) => `${v} for round${rounds.length === 1 ? "" : "s"} ${rounds.join(", ")}`,
          )
          .join("; ") +
        ". Every row is scored as it was published.";
  const meanField = n ? scored.reduce((a, p) => a + p.drivers.length, 0) / n : 0;
  const upcoming = predictions
    .filter((p) => p.snapshot === snapshot && p.result === null)
    .sort(byRound)[0];
  return {
    snapshot,
    scored,
    races: n,
    upcoming: upcoming ? races.get(upcoming.race_id) : undefined,
    wins: scored.filter((p) => p.result!.winner_hit).length,
    podiums: scored.reduce((a, p) => a + p.result!.podium_hits, 0),
    meanLogLoss: ll.mean,
    baselineRaces: ll.withBaseline,
    meanBaseline: ll.baselineMean,
    modelBetter: ll.modelBetter,
    // Races with no defined log loss, left out of both means and said so.
    undefinedLogLoss: ll.undefined,
    modelNote,
    undefinedNote:
      ll.undefined === 0
        ? ""
        : `${ll.undefined === 1 ? "One race has" : `${ll.undefined} races have`} no score, ` +
          "because the prediction gave the winner no chance at all, so both averages leave " +
          `${ll.undefined === 1 ? "it" : "them"} out. ${ll.undefined === 1 ? "It still counts" : "They still count"} ` +
          "as a missed winner and as a race where we did not beat the rule.",
    // What a uniform pick over the same field would score: the floor, printed
    // because a log loss on its own says nothing about whether this is any good.
    uniformLogLoss: meanField > 1 ? Math.log(meanField) : 0,
  };
}

const allSeries = SERIES.map(series);
const totalScored = allSeries.reduce((a, s) => a + s.races, 0);

const BLURB: Record<Snapshot, string> = {
  post_qualifying:
    "Published after qualifying, so it knows where everyone qualified and how quick they were in practice. Compared with a simple rule: " +
    `${BASELINE_PLAIN.post_qualifying}.`,
  post_practice:
    "Published after the last practice before qualifying, so it knows this weekend's practice pace but not the qualifying order. Compared with a simple rule that does not need this weekend at all: " +
    `${BASELINE_PLAIN.post_practice}. Going by practice times was tested as the rule too, and did worse.`,
  pre_weekend:
    "Published before the first practice session, so it knows nothing from this weekend. Compared with a simple rule that also uses only what is known before the weekend: " +
    `${BASELINE_PLAIN.pre_weekend}. Judging it against qualifying would be unfair: qualifying has not happened yet.`,
};
---

<BaseLayout
  title="Track record"
  description={
    totalScored
      ? "Every Sector 4 prediction scored against the result, with a simple rule's score beside it on every race."
      : "Predictions published in advance. Nothing scored yet: the first race is still to come."
  }
  image="/og/track-record.png"
  breadcrumbs={[{ name: "Track record", path: "/track-record/" }]}
>
  <section class="wrap page-hero">
    <p class="eyebrow">Track record</p>
    <h1>Every prediction, including the misses.</h1>
    <p class="lead">
      Each race is scored using the prediction we published before it started. Nothing is
      recalculated afterwards and no race is left out. Next to every score is the score of a simple
      rule on the same race, so you can judge whether the model adds anything.
    </p>
  </section>

  {totalScored === 0 && (
    <section class="wrap band" aria-labelledby="empty-h">
      <div class="card-soft empty">
        <h2 id="empty-h" class="h2">
          {firstRace
            ? `Scoring begins with the ${firstRace.name}.`
            : "Scoring begins with the first published prediction."}
        </h2>
        <p class="lead">
          {firstRace
            ? `Round ${firstRace.round} is the first race with a prediction published before the weekend began. When it has run, it becomes the first row below, whichever way it goes.`
            : "When a race with a published prediction has run, it becomes the first row below, whichever way it goes."}
        </p>
        <ul class="coming">
          <li class="rise" style="--i:0">
            <strong>A row per race.</strong> Whether we picked the winner, how many podium places we
            got right, our score and the simple rule's score on the same race.
          </li>
          <li class="rise" style="--i:1">
            <strong>Separate tables.</strong> The predictions before practice, after practice and
            after qualifying know different things, so each has its own table. They are never
            averaged together.
          </li>
          <li class="rise" style="--i:2">
            <strong>Season figures after four.</strong> Winner calls, podium places, average log
            loss and how often the model beat its baseline, once a series has four races scored.
          </li>
        </ul>
      </div>
    </section>
  )}

  {totalScored > 0 && (
    <section class="wrap band" aria-labelledby="key-h">
      <details class="key disclosure">
        <summary id="key-h">How to read these tables</summary>
        <dl class="defs">
          <div>
            <dt>Winner</dt>
            <dd>Picked if the driver we gave the best chance of winning did win.</dd>
          </div>
          <div>
            <dt>Podium</dt>
            <dd>How many of our three podium favourites finished in the top three.</dd>
          </div>
          <div>
            <dt>Score</dt>
            <dd>
              Based on the chance we gave the driver who actually won. Lower is better: giving the
              winner 100% would score 0, and a confident miss scores badly. Statisticians call this
              log loss.
            </dd>
          </div>
          <div>
            <dt>Rule and Beat rule</dt>
            <dd>
              The same score for a simple rule that knew what the prediction knew. If we cannot beat
              the rule, the model is not adding much.
            </dd>
          </div>
          <div>
            <dt>Brier</dt>
            <dd>
              A second score that looks at every driver's chance, not just the winner's. From 0 to
              2, lower is better.
            </dd>
          </div>
        </dl>
      </details>
    </section>
  )}

  {allSeries.map((s) => (
    <section class="wrap band" aria-labelledby={`${s.snapshot}-h`}>
      <div class="section-head">
        <p class="eyebrow">{SNAPSHOT_LABEL[s.snapshot]}</p>
        <h2 id={`${s.snapshot}-h`} class="h3">
          {s.races === 0
            ? "No races scored yet."
            : `${s.races} ${s.races === 1 ? "race" : "races"} scored.`}
        </h2>
        <p>{BLURB[s.snapshot]}</p>
      </div>

      {s.races >= SCORED_SUMMARY_MINIMUM ? (
        <>
          <dl class="figures summary">
            <div class="rise" style="--i:0">
              <dt>Winners picked</dt>
              <dd class="num">
                {s.wins} of {s.races}
              </dd>
            </div>
            <div class="rise" style="--i:1">
              <dt>Podium picks right</dt>
              <dd class="num">
                {s.podiums} of {s.races * 3}
              </dd>
            </div>
            <div class="rise" style="--i:2">
              <dt>Our average score</dt>
              <dd class="num">{s.meanLogLoss === null ? "—" : score(s.meanLogLoss)}</dd>
            </div>
            <div class="rise" style="--i:3">
              <dt>Simple rule's average</dt>
              <dd class="num">{s.meanBaseline === null ? "—" : score(s.meanBaseline)}</dd>
            </div>
            <div class="rise" style="--i:4">
              <dt>Races we beat the rule</dt>
              <dd class="num">
                {s.modelBetter} of {s.baselineRaces}
              </dd>
            </div>
          </dl>
          <p class="note">
            Lower is better. Picking a driver at random would score {score(s.uniformLogLoss)}, so
            beating that is the very least a prediction should do. {s.undefinedNote}{" "}
            <a href="/methodology/#scoring">How the scores are computed</a>.
          </p>
        </>
      ) : (
        <p class="notice">
          <span class="badge badge-ink">Season</span>
          <span>
            Season figures appear once four races are scored.{" "}
            {s.races === 0 ? "None so far." : `${s.races} so far.`} The simple rule here is{" "}
            {BASELINE_FOR[s.snapshot]}.
          </span>
        </p>
      )}

      <div class="scroller">
        <table class="table record">
          <caption class="sr-only">
            {SNAPSHOT_LABEL[s.snapshot]} predictions, most recent first, with the score of the{" "}
            {BASELINE_FOR[s.snapshot]} rule on the same race.
          </caption>
          <thead>
            <tr>
              <th scope="col">Rd</th>
              <th scope="col">Race</th>
              <th scope="col">Winner</th>
              <th scope="col" class="n">
                Podium
              </th>
              <th scope="col" class="n">
                Score
              </th>
              <th scope="col" class="n">
                Rule
              </th>
              <th scope="col">Beat rule</th>
              <th scope="col" class="n">
                Brier
              </th>
            </tr>
          </thead>
          <tbody>
            {s.races === 0 ? (
              <tr class="none">
                <td colspan="8">
                  {s.upcoming
                    ? `The first row will be the ${s.upcoming.name}, once it has run.`
                    : `No ${SNAPSHOT_LABEL[s.snapshot].toLowerCase()} prediction has been published yet.`}
                </td>
              </tr>
            ) : (
              s.scored.map((p, i) => {
                const race = races.get(p.race_id)!;
                const r = p.result!;
                return (
                  <tr class="rise" style={`--i:${i}`}>
                    <td class="num dim">{p.round}</td>
                    <th scope="row">
                      <a href={`/races/${race.season}/${race.slug}/`}>{race.name}</a>
                      <span class="season num">{race.season}</span>
                    </th>
                    <td>{r.winner_hit ? "Picked" : "Missed"}</td>
                    <td class="n num">{r.podium_hits} of 3</td>
                    <td class="n num">{logLoss(r.log_loss)}</td>
                    <td class="n num dim">{r.baseline ? score(r.baseline.log_loss) : "—"}</td>
                    <td>
                      {r.baseline
                        ? r.log_loss !== null && r.log_loss < r.baseline.log_loss
                          ? "Yes"
                          : "No"
                        : "—"}
                    </td>
                    <td class="n num">{score(r.brier)}</td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
      {s.modelNote && <p class="note footnote">{s.modelNote}</p>}
      {s.undefinedLogLoss > 0 && (
        <p class="note footnote">
          No score: the prediction gave that race's winner no chance at all, so there is nothing to
          score. The race page explains.
        </p>
      )}
    </section>
  ))}

  {pending.length > 0 && (
    <section class="wrap band" aria-labelledby="pending-h">
      <div class="section-head">
        <p class="eyebrow">Pending</p>
        <h2 id="pending-h" class="h3">
          Published, not yet scored.
        </h2>
        <p>
          These predictions are already public. They move into the tables above once the race has
          run, whichever way they go.
        </p>
      </div>
      <ul class="pending">
        {pending.map((p, i) => {
          const race = races.get(p.race_id)!;
          const snapshots = predictionsForRace(predictions, p.race_id);
          return (
            <li class="rise" style={`--i:${i}`}>
              <a class="card pending-card" href={`/races/${race.season}/${race.slug}/`}>
                <span class="title">{race.name}</span>
                <span class="body-sm muted">
                  Round {race.round} of {race.season}, starts{" "}
                  <time datetime={race.starts_at} data-local>
                    {formatUtc(race.starts_at)}
                  </time>
                </span>
                <span class="badges">
                  {snapshots.map((s) => (
                    <span class="badge badge-soft">
                      {s.revisions.length > 1
                        ? `${SNAPSHOT_LABEL[s.snapshot]}, ${s.revisions.length} revisions, revision ${s.revision} counts`
                        : SNAPSHOT_LABEL[s.snapshot]}
                    </span>
                  ))}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="wrap band">
    <p class="note">
      Scores use the exact chances we published, not the rounded figures shown on the site. The
      predictions are never averaged together: they know different things and are compared with
      different rules, so an average would describe neither.
    </p>
    <!-- prettier-ignore -->
    <p class="note">Data version <span class="num">{meta.data_version}</span>, built <time datetime={meta.generated_at} data-local>{formatUtc(meta.generated_at)}</time>.</p>
  </section>
</BaseLayout>

<style>
  .empty {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-lg);
  }
  @media (min-width: 900px) {
    .empty {
      padding: var(--space-xxl);
    }
  }
  .empty h2 {
    max-width: 20ch;
  }
  .empty .lead {
    max-width: 52ch;
  }
  .coming {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }
  @media (min-width: 900px) {
    .coming {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .coming li {
    background: var(--colour-canvas);
    border-radius: var(--rounded-sm);
    padding: var(--space-md);
    font-size: 14px;
    line-height: 1.43;
    color: var(--colour-text-muted);
  }
  .coming strong {
    display: block;
    margin-bottom: var(--space-xxs);
    color: var(--colour-ink);
    font-size: 16px;
  }

  .summary {
    margin-bottom: var(--space-md);
  }
  .notice {
    margin-bottom: var(--space-lg);
  }
  .note {
    font-size: 14px;
    line-height: 1.43;
    color: var(--colour-text-muted);
    max-width: 68ch;
    margin-bottom: var(--space-lg);
  }
  .footnote {
    margin: var(--space-sm) 0 0;
  }
  .record {
    min-width: 720px;
  }
  .season {
    margin-left: var(--space-xs);
    font-size: 12px;
    font-weight: var(--weight-text);
    color: var(--colour-text-muted);
  }
  .none td {
    padding: var(--space-lg) var(--space-md);
    color: var(--colour-text-muted);
  }
  .table tbody tr.none:hover {
    background: transparent;
  }

  .pending {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }
  @media (min-width: 900px) {
    .pending {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .pending-card {
    display: grid;
    gap: var(--space-xs);
    height: 100%;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }
  /* On a hovered card the soft badge would vanish into the same tint. */
  .pending-card:hover .badge-soft,
  .pending-card:focus-visible .badge-soft {
    background: var(--colour-canvas);
  }
</style>
