---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { loadDataset, raceById, predictionsForRace } from "../lib/data";
import { score } from "../lib/format";
import { formatUtc } from "../lib/time";
import type { Prediction } from "../lib/schema";

const { reference, predictions, meta } = loadDataset();
const races = raceById(reference);

// Predicted but not yet run. Listed so the record cannot be read as a
// selection of the races that happened to go well.
const pending = predictions
  .filter((p) => p.result === null)
  .filter((p, i, all) => all.findIndex((q) => q.race_id === p.race_id) === i)
  .sort((a, b) => a.season - b.season || a.round - b.round);

/**
 * The two snapshots are kept apart, always.
 *
 * They are different models judged against different baselines: post-qualifying
 * sees the grid and practice pace and is measured against qualifying order;
 * pre-weekend sees neither and is measured against championship order. Pooling
 * them would produce an average that describes neither, and would flatter the
 * weaker of the two by mixing it with the stronger.
 */
function series(snapshot: Prediction["snapshot"]) {
  const scored = predictions
    .filter((p) => p.snapshot === snapshot && p.result !== null)
    .sort((a, b) => b.season - a.season || b.round - a.round);
  const n = scored.length;
  const withBase = scored.filter((p) => p.result!.baseline !== null);
  const meanField = n ? scored.reduce((a, p) => a + p.drivers.length, 0) / n : 0;
  return {
    snapshot,
    scored,
    races: n,
    wins: scored.filter((p) => p.result!.winner_hit).length,
    podiums: scored.reduce((a, p) => a + p.result!.podium_hits, 0),
    meanLogLoss: n ? scored.reduce((a, p) => a + p.result!.log_loss, 0) / n : 0,
    meanBrier: n ? scored.reduce((a, p) => a + p.result!.brier, 0) / n : 0,
    baselineName: withBase[0]?.result!.baseline!.name ?? null,
    baselineRaces: withBase.length,
    meanBaseline: withBase.length
      ? withBase.reduce((a, p) => a + p.result!.baseline!.log_loss, 0) / withBase.length
      : 0,
    modelBetter: withBase.filter((p) => p.result!.log_loss < p.result!.baseline!.log_loss).length,
    // What a uniform pick over the same field would score: the floor, printed
    // because a log loss on its own says nothing about whether this is any good.
    uniformLogLoss: meanField > 1 ? Math.log(meanField) : 0,
  };
}

const allSeries = [series("post_qualifying"), series("pre_weekend")];
const totalScored = allSeries.reduce((a, s) => a + s.races, 0);

const SNAPSHOT_LABEL = { pre_weekend: "Pre-weekend", post_qualifying: "Post-qualifying" } as const;
---

<BaseLayout
  title="Track record"
  description={
    totalScored
      ? "Every Sector 4 prediction scored against the result, with the baseline's score beside it on every race."
      : "Predictions published in advance. Nothing scored yet — the first race is still to come."
  }
  image="/og/track-record.png"
  breadcrumbs={[{ name: "Track record", path: "/track-record/" }]}
>
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Track record</p>
      <h1>Every prediction, including the misses</h1>
      <p class="sub">
        Each race is scored against the snapshot published before it started. Nothing is
        recalculated afterwards, and no race is left out. The baseline's score for the same race
        sits beside the model's, so you can judge whether the model is adding anything.
      </p>
    </div>
  </section>

  {totalScored === 0 && (
    <section class="band">
      <div class="wrap">
        <h2>Nothing scored yet</h2>
        <p class="note">
          Predictions are published before the session they predict and scored afterwards, in a
          separate step, so the record cannot be edited once a result is known. The first race has
          not run. When it does, its scores appear here — whichever way they go.
        </p>
      </div>
    </section>
  )}

  {allSeries.map((s, i) => (
    <section class:list={["band", i % 2 === 1 ? "band-soft" : ""]}>
      <div class="wrap">
        <p class="eyebrow">{SNAPSHOT_LABEL[s.snapshot]}</p>
        <h2>
          {s.races === 0
            ? `${SNAPSHOT_LABEL[s.snapshot]} — no races scored yet`
            : `${s.races} ${s.races === 1 ? "race" : "races"} scored`}
        </h2>
        <p class="note">
          {s.snapshot === "post_qualifying"
            ? "Published after qualifying, so it sees the grid and this weekend's practice pace. Measured against qualifying order."
            : "Published before any car runs. It cannot see qualifying or practice, so it uses two features and is measured against championship order — judging it against qualifying order would score it on information it does not have."}
        </p>

        {s.races > 0 && (
          <Fragment>
            <dl class="summary">
              <div>
                <dt>Winner called</dt>
                <dd class="num">
                  {s.wins} of {s.races}
                </dd>
              </div>
              <div>
                <dt>Podium places</dt>
                <dd class="num">
                  {s.podiums} of {s.races * 3}
                </dd>
              </div>
              <div>
                <dt>Model, mean log loss</dt>
                <dd class="num">{score(s.meanLogLoss)}</dd>
              </div>
              <div>
                <dt>{s.baselineName ?? "Baseline"}, mean</dt>
                <dd class="num">{s.baselineRaces ? score(s.meanBaseline) : "—"}</dd>
              </div>
              <div>
                <dt>Races the model won</dt>
                <dd class="num">
                  {s.modelBetter} of {s.baselineRaces}
                </dd>
              </div>
            </dl>
            <p class="note">
              A uniform pick over the same field would score {score(s.uniformLogLoss)}. Lower is
              better, and beating that is the floor rather than the goal.{" "}
              <a href="/methodology/">How the scores are computed</a>.
            </p>

            <div class="scroller">
              <table>
                <caption class="sr-only">
                  {SNAPSHOT_LABEL[s.snapshot]} predictions, most recent first, with the baseline's
                  score for the same race.
                </caption>
                <thead>
                  <tr>
                    <th scope="col" class="pos">
                      Rd
                    </th>
                    <th scope="col">Race</th>
                    <th scope="col">Winner</th>
                    <th scope="col" class="n">
                      Podium
                    </th>
                    <th scope="col" class="n">
                      Log loss
                    </th>
                    <th scope="col" class="n">
                      Baseline
                    </th>
                    <th scope="col" class="n">
                      Brier
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {s.scored.map((p) => {
                    const race = races.get(p.race_id)!;
                    const r = p.result!;
                    return (
                      <tr>
                        <td class="pos num">{p.round}</td>
                        <th scope="row">
                          <a href={`/races/${race.season}/${race.slug}/`}>{race.name}</a>
                          <span class="season num">{race.season}</span>
                        </th>
                        <td
                          class:list={["outcome", r.winner_hit ? "hit" : "miss"]}
                          data-label="Winner"
                        >
                          {r.winner_hit ? "Hit" : "Miss"}
                        </td>
                        <td class="n num" data-label="Podium">
                          {r.podium_hits} of 3
                        </td>
                        <td class="n num" data-label="Log loss">
                          {score(r.log_loss)}
                        </td>
                        <td
                          class:list={[
                            "n",
                            "num",
                            r.baseline && r.log_loss < r.baseline.log_loss ? "hit" : "dim",
                          ]}
                          data-label="Baseline"
                        >
                          {r.baseline ? score(r.baseline.log_loss) : "—"}
                        </td>
                        <td class="n num" data-label="Brier">
                          {score(r.brier)}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </Fragment>
        )}
      </div>
    </section>
  ))}

  {pending.length > 0 && (
    <section class="band">
      <div class="wrap">
        <h2>Published, not yet scored</h2>
        <p class="note">
          These predictions are already public. They will appear above with their scores once the
          race has run, whichever way they go.
        </p>
        <ul class="pending">
          {pending.map((p) => {
            const race = races.get(p.race_id)!;
            const snapshots = predictionsForRace(predictions, p.race_id);
            return (
              <li>
                <a href={`/races/${race.season}/${race.slug}/`}>{race.name}</a>
                <span class="meta">
                  Round {race.round} ·{" "}
                  {snapshots.map((s) => SNAPSHOT_LABEL[s.snapshot]).join(" and ")} ·{" "}
                  <time datetime={race.starts_at}>{formatUtc(race.starts_at)}</time>
                </span>
                {snapshots
                  .filter((s) => s.revisions.length > 1)
                  .map((s) => (
                    <span class="meta">
                      {SNAPSHOT_LABEL[s.snapshot]}: {s.revisions.length} revisions published,
                      revision {s.revision} counts ·{" "}
                      <a href={`/races/${race.season}/${race.slug}/`}>see why</a>
                    </span>
                  ))}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="band band-soft">
    <div class="wrap">
      <p class="note">
        Data version <span class="num">{meta.data_version}</span>, generated{" "}
        <time datetime={meta.generated_at}>{formatUtc(meta.generated_at)}</time>. Scores are
        computed from the stored probabilities, not from the rounded figures shown here. The two
        snapshots are never pooled: they are different models measured against different baselines,
        and an average across them would describe neither.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .sub {
    color: var(--colour-text-muted);
    margin-top: var(--space-sm);
    max-width: 62ch;
  }
  .summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0 0;
  }
  .summary div {
    border-top: 1px solid var(--colour-hairline);
    padding-top: var(--space-xs);
  }
  dt {
    font-size: 12px;
    font-weight: 600;
    color: var(--colour-text-muted);
  }
  dd {
    margin: var(--space-xxs) 0 0;
    font-size: 20px;
    color: var(--colour-ink);
  }
  .note {
    margin-top: var(--space-lg);
    font-size: 14px;
    color: var(--colour-text-muted);
    max-width: 68ch;
  }
  .scroller {
    overflow-x: auto;
    margin-top: var(--space-lg);
  }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    text-align: left;
    padding: var(--space-sm) var(--space-xs);
    font-weight: 400;
    white-space: nowrap;
  }
  thead th {
    font-size: 12px;
    font-weight: 600;
    color: var(--colour-text-muted);
    border-bottom: 1px solid var(--colour-hairline);
  }
  tbody tr {
    border-bottom: 1px solid var(--colour-hairline);
  }
  tbody th {
    font-weight: 600;
  }
  .season {
    display: block;
    font-size: 12px;
    color: var(--colour-text-muted);
  }
  .snap {
    color: var(--colour-text-muted);
  }
  .pos {
    width: 3ch;
    color: var(--colour-text-muted);
  }
  .n {
    text-align: right;
  }
  .outcome {
    font-weight: 600;
  }
  .hit {
    color: var(--colour-ink);
  }
  .miss {
    color: var(--colour-text-muted);
  }
  /* Below 640px the row becomes a block. A horizontal scroller put every score
     — the whole point of the page — off the right edge of a phone. */
  @media (max-width: 639px) {
    .scroller {
      overflow-x: visible;
    }
    table {
      min-width: 0;
    }
    thead,
    .pos {
      display: none;
    }
    tbody tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xxs) var(--space-sm);
      padding: var(--space-sm) 0;
    }
    tbody th {
      grid-column: 1 / -1;
      padding: 0 0 var(--space-xs);
    }
    tbody td {
      padding: 0;
      text-align: left;
      font-size: 13px;
      white-space: nowrap;
    }
    /* Decorative: the <th> in thead still names the column for assistive tech. */
    tbody td::before {
      content: attr(data-label) " ";
      color: var(--colour-text-muted);
      font-weight: 400;
    }
  }

  .pending {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }
  .pending li {
    border-top: 1px solid var(--colour-hairline);
    padding-top: var(--space-sm);
  }
  .pending a {
    font-weight: 600;
  }
  .pending .meta {
    display: block;
    font-size: 13px;
    color: var(--colour-text-muted);
    margin-top: var(--space-xxs);
  }
</style>
