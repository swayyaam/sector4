{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sector4.dev/schema/site_meta.schema.json",
  "title": "Site metadata",
  "description": "Freshness and next-race context shown across the site. All instants are UTC; the site renders them in the viewer's local time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["data_version", "generated_at", "is_mock", "last_completed_race", "next_race"],
  "properties": {
    "data_version": { "type": "string", "minLength": 1, "examples": ["v0.1.1-data"] },
    "generated_at": { "type": "string", "format": "date-time", "description": "When this file was built. Drives the freshness indicator." },
    "is_mock": {
      "type": "boolean",
      "description": "Single site-wide flag. When true every page must render the preview banner."
    },
    "last_completed_race": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/raceRef" }]
    },
    "next_race": {
      "oneOf": [
        { "type": "null", "description": "Season over" },
        {
          "allOf": [
            { "$ref": "#/$defs/raceRef" },
            {
              "type": "object",
              "required": ["sessions"],
              "properties": {
                "sessions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "starts_at"],
                    "properties": {
                      "name": {
                        "type": "string",
                        "enum": ["Practice 1", "Practice 2", "Practice 3", "Sprint Qualifying", "Sprint Shootout", "Sprint", "Qualifying", "Race"]
                      },
                      "starts_at": { "type": "string", "format": "date-time", "description": "UTC" }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  "$defs": {
    "raceRef": {
      "type": "object",
      "required": ["race_id", "season", "round", "name", "slug", "circuit_id", "starts_at"],
      "properties": {
        "race_id": { "type": "integer", "minimum": 1 },
        "season": { "type": "integer", "minimum": 1950, "maximum": 2100 },
        "round": { "type": "integer", "minimum": 1, "maximum": 30 },
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "circuit_id": { "type": "integer", "minimum": 1 },
        "starts_at": { "type": "string", "format": "date-time", "description": "Race start, UTC" }
      }
    }
  }
}
