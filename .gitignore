# Data (rebuildable: Kaggle download + fetch_jolpica.py)
data/raw/
# data/processed/ is rebuildable and not committed -- except the small,
# auditable ID maps. Git cannot re-include a file inside an ignored directory,
# so the directory itself stays visible, its contents are ignored, and id_maps
# is let back in. (Ignoring "data/processed/" outright silently kept id_maps out
# of the repo, and CI ran without them.)
data/processed/*
!data/processed/id_maps/

# Python
__pycache__/
*.pyc
.venv/
.env

# OS
.DS_Store

# local snapshot used to prove data/processed did not change
data/processed_*_snapshot/

# FastF1 cache (rebuildable)
data/raw/fastf1/
data/enriched/

# Web
web/node_modules/
web/dist/
web/.astro/
.DS_Store

# Feature frames (derived from data/processed + data/enriched, rebuildable)
data/features/
